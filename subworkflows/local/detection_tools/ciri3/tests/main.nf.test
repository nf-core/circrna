nextflow_workflow {
    name 'Test Workflow CIRI3'
    script '../main.nf'
    workflow 'CIRI3'
    config './nextflow.config'

    tag 'subworkflows'
    tag 'subworkflows_local'
    tag 'ciri3'

    setup {
        run('BWA_INDEX') {
            script 'modules/nf-core/bwa/index/main.nf'
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                """
            }
        }
        run('BWA_MEM') {
            script 'modules/nf-core/bwa/mem/main.nf'
            process {
                """
                input[0] = [[id: 'cel_N2_1', single_end: false], [
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                ]]
                input[1] = BWA_INDEX.out.index
                input[2] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                input[3] = false
                """
            }
        }
    }

    test('CIRI3 detection') {
        when {
            workflow {
                """
                input[0] = BWA_MEM.out.sam
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bed.size() == 1 },
                { assert path(workflow.out.bed[0][1]).readLines().every { it.split('\\t').length == 7 } },
                { assert workflow.out.versions.size() == 1 }
            )
        }
    }

    test('CIRI3 detection stub') {
        options '-stub'
        when {
            workflow {
                """
                input[0] = BWA_MEM.out.sam
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bed.size() == 1 },
                { assert path(workflow.out.bed[0][1]).exists() }
            )
        }
    }
}
