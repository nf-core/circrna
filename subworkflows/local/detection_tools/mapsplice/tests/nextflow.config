// Copies of the matching blocks in conf/modules.config (publishDir removed): the '.*:' selectors there only match below NFCORE_CIRCRNA.
process {
    withName: 'MAPSPLICE:ALIGN' {
        ext.args   = [
            "",
            "--seglen 25",
            "--min-intron 20",
            "--max-intron 1000000",
            "--min-map-len 40",
            "--min-fusion-distance 200",
            "--fusion-non-canonical",
        ].join(' ').trim()
    }

    withName: 'MAPSPLICE:UNIFY' {
        ext.args   = "-v FS='\\t' -v OFS='\\t' '{ split(\$4, a, \"/\"); print \$1, \$2, \$3, \"FUSIONJUNC_\" (NR-1) \"/\" a[2], a[2], \$6 }'"
        ext.suffix = "mapsplice.bed"
    }
}
