process {
    withName: AGAT_CONVERTSPGFF2GTF {
        ext.args = '--gtf_version 3'
    }
    withName: '(.*:)?CIRCMINER:INFER_STRAND' {
        ext.prefix = { "${meta.id}.circminer" }
    }
    withName: '(.*:)?CIRCMINER:UNIFY' {
        ext.args   = "-v FS='\\t' -v OFS='\\t' '{ if (\$8 == \"Pass\") { print \$1, \$2 - 1, \$3, \"FUSIONJUNC_\" (NR - 1) \"/\" \$4, \$4, \".\", \$9 } }'"
        ext.prefix = { "${meta.id}.circminer.unified" }
    }
}
