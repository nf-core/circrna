// Copies of the matching blocks in conf/modules.config (publishDir removed): the '.*:' selectors there only match below NFCORE_CIRCRNA.
process {
    withName: 'CIRI:UNIFY' {
        ext.args   = "-v OFS='\\t' '{ if (NR > 1) { count = substr(\$14, 1, index(\$14, \".\") - 1); print \$2, \$3, \$4, \"FUSIONJUNC_\" (NR-2) \"/\" \$5, \$5, \$11, \$12 } }'"
        ext.suffix = "ciri.bed"
    }

    withName: 'CIRI:SEQKIT_FX2TAB' {
        ext.args   = '-l -n'
        ext.suffix = 'txt'
    }

    withName: 'CIRI:READLENGTH' {
        ext.prefix = { "${meta.id}_readlength" }
    }

    withName: 'CIRI:FASTP' {
        ext.args   = { "--max_len1 ${meta.target_length} --max_len2 ${meta.target_length} --length_required ${meta.target_length}" }
    }

    withName: 'CIRI:BWA_MEM' {
        ext.args   = '-T 19'
    }
}
