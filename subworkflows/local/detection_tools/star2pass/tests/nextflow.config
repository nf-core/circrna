process {
    withName: '.*STAR2PASS:PASS_1' {
        ext.args = {
            [
                '--chimOutType Junctions WithinBAM',
                '--outSAMunmapped Within',
                '--outFilterType BySJout',
                '--outReadsUnmapped None',
                '--readFilesCommand zcat',
                "--alignSJDBoverhangMin ${params.alignSJDBoverhangMin}",
                "--limitSjdbInsertNsj ${params.limitSjdbInsertNsj}",
                "--chimJunctionOverhangMin ${params.chimJunctionOverhangMin}",
                "--chimSegmentMin ${params.chimSegmentMin}",
            ].join(' ')
        }
    }
    withName: '.*STAR2PASS:PASS_2' {
        ext.args = {
            [
                params.tools.split(',').contains('circrna_finder') ? '--chimOutType Junctions SeparateSAMold' : '--chimOutType Junctions WithinBAM',
                '--outSAMunmapped Within',
                '--outFilterType BySJout',
                '--outReadsUnmapped None',
                '--readFilesCommand zcat',
                '--outSAMattributes NH HI AS nM jI',
                '--sjdbFileChrStartEnd dataset.SJ.out.tab',
                "--alignSJDBoverhangMin ${params.alignSJDBoverhangMin}",
                "--limitSjdbInsertNsj ${params.limitSjdbInsertNsj}",
                "--chimJunctionOverhangMin ${params.chimJunctionOverhangMin}",
                "--chimSegmentMin ${params.chimSegmentMin}",
            ].join(' ')
        }
    }
    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 8 --sjdbOverhang 100'
    }

    withName: 'PASS_1|PASS_2' {
        cpus = 1
    }
}
