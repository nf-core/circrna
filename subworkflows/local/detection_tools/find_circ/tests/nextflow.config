// Copies of the matching blocks in conf/modules.config (publishDir removed): the '.*:' selectors there only match below NFCORE_CIRCRNA.
process {
    withName: 'FIND_CIRC:ALIGN' {
        ext.args   = {
            "--very-sensitive --mm -D 20 --score-min=C,-15,0 -q " + (!meta.strandedness || meta.strandedness == 'unstranded' || meta.strandedness == 'auto'
                ? ''
                : meta.strandedness == 'forward' ? ' --norc' : ' --nofw')
        }
    }

    withName: 'FIND_CIRC:SAMTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_unmapped" }
        ext.args   = "-hf 4"
    }

    withName: 'FIND_CIRC:MAIN' {
        ext.args   = {
            !meta.strandedness || meta.strandedness == 'unstranded' || meta.strandedness == 'auto'
                ? ''
                : meta.strandedness == 'forward' ? ' --norc' : ' --nofw'
        }
    }

    withName: 'FIND_CIRC:EXTRACT_READS' {
        ext.args   = "-c fastx '{ print \$name, \$comment }' OFS='\\t'"
        ext.suffix = "reads.tsv"
    }

    withName: 'FIND_CIRC:GROUP_READS' {
        ext.args   = "-g 1 -f 2:unique -t -s ',' -H"
        ext.prefix = { "${meta.id}_grouped" }
    }

    withName: 'FIND_CIRC:JOIN_READS' {
        ext.args   = "-f '4;1' -k -t -H"
        ext.prefix = { "${meta.id}_joined" }
    }

    withName: 'FIND_CIRC:UNIFY' {
        ext.args   = "-v FS='\\t' -v OFS='\\t' '{ if (\$18 ~ /CIRCULAR/ && \$18 ~ /UNAMBIGUOUS_BP/ && \$18 ~ /ANCHOR_UNIQUE/) { print \$1, \$2, \$3, \"FUSIONJUNC_\" (NR-1) \"/\" \$5, \$5, \$6, \$19 } }'"
        ext.suffix = "find_circ.bed"
    }
}
