includeConfig '../../star2pass/tests/nextflow.config'

process {
    withName: '(.*:)?CIRCTOOLS:UNIFY' {
        ext.prefix = { "${meta.id}.circtools" }
    }
    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 8 --sjdbOverhang 100'
    }

    withName: '.*:PASS_[12]' {
        cpus = 1
    }
}
