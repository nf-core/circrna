nextflow_workflow {

    name "Test Workflow SEGEMEHL"
    script "../main.nf"
    workflow "SEGEMEHL"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "segemehl"

    test("cel_N2_1 paired-end - build index") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = channel.of([
                    [id: 'reference'],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[2] = null
                """
            }
        }

        then {
            def bed = path(workflow.out.bed[0][1]).readLines()
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.bed.collect { file(it[1]).name },
                    bed.size(),
                    bed.sort(),
                ).match() }
            )
        }
    }

    test("cel_N2_1 paired-end - prebuilt index") {
        setup {
            run("SEGEMEHL_INDEX") {
                script "modules/nf-core/segemehl/index/main.nf"
                process {
                    """
                    input[0] = [
                        [id: 'prebuilt_reference'],
                        file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = channel.of([
                    [id: 'reference'],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[2] = SEGEMEHL_INDEX.out.index
                """
            }
        }

        then {
            def bed = path(workflow.out.bed[0][1]).readLines()
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.bed.collect { file(it[1]).name },
                    bed.size(),
                    bed.sort(),
                ).match() }
            )
        }
    }

    test("reference tuple is reused for each sample") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def reads = [
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                ]
                input[0] = channel.of(
                    [[id: 'cel_N2_1', single_end: false], reads],
                    [[id: 'cel_N2_2', single_end: false], reads]
                )
                input[1] = channel.of([
                    [id: 'reference'],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[2] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().count { task -> task.name.contains('SEGEMEHL:ALIGN') } == 2 },
                { assert workflow.out.bed.collect { file(it[1]).name }.sort() == [
                    'cel_N2_1.segemehl.unified.bed',
                    'cel_N2_2.segemehl.unified.bed'
                ] }
            )
        }
    }

    test("cel_N2_1 paired-end - stub") {
        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = channel.of([
                    [id: 'reference'],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[2] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
