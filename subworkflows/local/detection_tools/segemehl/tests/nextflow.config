process {
    withName: '(.*:)?SEGEMEHL:ALIGN' {
        ext.args = '-b -S'
    }
    withName: '(.*:)?SEGEMEHL:EXTRACT' {
        ext.args = "-v FS='\\t' -v OFS='\\t' '{ if (\$4 ~ /;C;/) { split(\$4, a, \";\"); split(a[3], b, \"/\"); print \$1, \$2, \$3, \$1 \":\" \$2 \"-\" \$3 \":\" \$6, \$5, \$6, b[1] } }'"
    }
    withName: '(.*:)?SEGEMEHL:SORT' {
        ext.args = '-k1,1 -k2,2n -k3,3n -k4,4 -k6,6'
    }
    withName: '(.*:)?SEGEMEHL:GROUP' {
        ext.args = '-g 1,2,3,4,6 -o count,distinct'
    }
    withName: '(.*:)?SEGEMEHL:UNIFY' {
        ext.args = "-v FS='\\t' -v OFS='\\t' '{ print \$1, \$2, \$3, \"FUSIONJUNC_\" (NR-1) \"/\" \$6, \$6, \$5, \$7 }'"
    }
}
