process {
    // These intermediates are inspected by the tests but are not workflow outputs.
    withName: CIRCTEST_CIRCTEST {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/circtest" },
            mode: 'copy',
        ]
    }
    withName: CIRIQUANT_PREPDE {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/ciriquant_de/ciriquant_prep" },
            mode: 'copy',
        ]
    }
    withName: CIRIQUANT_DE {
        errorStrategy = 'ignore'
    }
}
