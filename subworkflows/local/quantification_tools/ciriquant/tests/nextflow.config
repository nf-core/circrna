process {
    withName: 'CIRIQUANT:EXTRACT_CIRC' {
        ext.args   = "-k circ_id,gene_id,score -s \\\t"
        ext.suffix = "circ.tsv"
    }

    withName: 'CIRIQUANT:EXTRACT_GENES' {
        ext.args   = "-v FS='\\t' -v OFS='\\t' '{ print \$1, \$2, \$9 }'"
        ext.suffix = "gene.tsv"
    }

    withName: 'CIRIQUANT:JOIN_CIRC' {
        ext.metacols = "circ_id,gene_id"
    }
}
