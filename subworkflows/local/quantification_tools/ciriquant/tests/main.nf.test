nextflow_workflow {

    name "Test Workflow CIRIQUANT"
    script "../main.nf"
    workflow "CIRIQUANT"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "ciriquant"
    tag "quantification_tools_ciriquant"

    setup {
        run("BWA_INDEX") {
            script "modules/nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }
        run("HISAT2_BUILD") {
            script "modules/nf-core/hisat2/build/main.nf"
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[1] = [ [:], [] ]
                input[2] = [ [:], [] ]
                """
            }
        }
    }

    test("paired-end mini samples - header-only circRNA tables") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)
                ])
                input[2] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ])
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[4] = BWA_INDEX.out.index.collect()
                input[5] = HISAT2_BUILD.out.index.collect()
                """
            }
        }

        then {
            def gene = path(workflow.out.gene_tpm[0][1]).csv(sep: '\t')
            assertAll(
                { assert workflow.success },
                { assert gene.columnNames.sort(false) == [ 'cel_N2_1', 'fust1_1', 'gene_id', 'gene_name' ] },
                { assert gene.rowCount > 0 },
                { assert path(workflow.out.circ_cpm[0][1]).readLines().size() == 1 },
                { assert path(workflow.out.circ_cpm[0][1]).readLines()[0].split('\t').toList().sort() == [ 'cel_N2_1', 'circ_id', 'fust1_1', 'gene_id' ] },
                { assert workflow.out.raw.size() == 2 },
                { assert workflow.out.stringtie.size() == 2 },
                { assert snapshot(
                    workflow.out.gene_tpm.collect { meta, f -> [ meta, file(f).name ] },
                    workflow.out.circ_cpm.collect { meta, f -> [ meta, file(f).name ] },
                    workflow.out.raw.collect { meta, f -> [ meta.id, file(f).name ] }.sort(),
                    workflow.out.stringtie.collect { meta, f -> [ meta.id, file(f).name ] }.sort(),
                    gene.columnNames.sort(false),
                    gene.rowCount
                ).match() }
            )
        }
    }

    test("paired-end mini samples - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)
                ])
                input[2] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ])
                input[3] = channel.value([
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ])
                input[4] = BWA_INDEX.out.index.collect()
                input[5] = HISAT2_BUILD.out.index.collect()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
