process {
    withName: 'QUANTIFICATION:PSIRC_QUANT:JOIN_(GENE|TX)_(COUNTS|TPM)' {
        ext.args = "-f 1,2 -t"
    }

    withName: 'QUANTIFICATION:CIRIQUANT:EXTRACT_CIRC' {
        ext.args   = "-k circ_id,gene_id,score -s \\\t"
        ext.suffix = "circ.tsv"
    }

    withName: 'QUANTIFICATION:CIRIQUANT:EXTRACT_GENES' {
        ext.args   = "-v FS='\\t' -v OFS='\\t' '{ print \$1, \$2, \$9 }'"
        ext.suffix = "gene.tsv"
    }

    withName: 'QUANTIFICATION:CIRIQUANT:JOIN_CIRC' {
        ext.metacols = "circ_id,gene_id"
    }

    withName: 'QUANTIFICATION:AGGREGATE' {
        publishDir = [
            path: { "${params.outdir}/aggregations" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
