nextflow_workflow {

    name "Test Workflow QUANTIFICATION"
    script "../main.nf"
    workflow "QUANTIFICATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "quantification"

    test("psirc and sum aggregation") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true) ])
                input[4] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.filtered.gtf', checkIfExists: true) ])
                input[5] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[6] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.gtf', checkIfExists: true) ])
                input[7] = channel.of(
                    [ [ id:'fust1_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.meta.bed', checkIfExists: true) ]
                )
                input[8] = 2
                input[9] = channel.value([ [ id:'phenotype' ], file(params.pipelines_testdata_base_path + 'mini/phenotype.csv', checkIfExists: true) ])
                input[10] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/chrI_mini.fa.fai', checkIfExists: true) ])
                input[11] = channel.value([ [:], [] ])
                input[12] = channel.value([ [:], [] ])
                input[13] = ['psirc', 'sum']
                input[14] = 0
                input[15] = true
                input[16] = channel.empty()
                """
            }
        }

        then {
            def circular = path(workflow.out.circ.find { it[0].quantification == 'psirc' }[1]).csv(sep: '\t')
            def gene = path(workflow.out.gene.find { it[0].quantification == 'psirc' }[1]).csv(sep: '\t')
            def sum = path("$outputDir/5_quantification/aggregations/sum.tsv").csv(sep: '\t')
            assertAll(
                { assert workflow.success },
                { assert workflow.out.ciriquant.isEmpty() },
                { assert workflow.out.stringtie.isEmpty() },
                { assert !new File("$outputDir/5_quantification/aggregations/max.tsv").exists() },
                { assert circular.columnNames == [ 'tx', 'gene_id', 'cel_N2_1', 'fust1_1' ] },
                { assert circular.rowCount > 0 },
                { assert gene.rowCount > 0 },
                { assert workflow.out.rds.size() == 1 },
                { assert sum.columnNames == [ 'id', 'cel_N2_1', 'fust1_1' ] },
                { assert sum.rowCount > 0 },
                { assert snapshot(
                    workflow.out.gene.collect { meta, f -> [ meta, file(f).name ] }.sort { it[0].id },
                    workflow.out.circ.collect { meta, f -> [ meta, file(f).name ] }.sort { it[0].id },
                    workflow.out.rds.collect { meta, f -> [ meta, file(f).name ] },
                    workflow.trace.tasks().collect { it.name.replaceAll(/ \(.*\)/, '') }.unique().sort().findAll { it.contains('AGGREGATE') },
                    circular.columns['tx'],
                    gene.rowCount,
                    sum.rowCount,
                    sum.rows.collect { row -> "${row.id}\t${row.cel_N2_1}\t${row.fust1_1}".toString() }
                ).match() }
            )
        }
    }

    test("psirc, ciriquant and max aggregation") {

        setup {
            run("BWA_INDEX") {
                script "modules/nf-core/bwa/index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("HISAT2_BUILD") {
                script "modules/nf-core/hisat2/build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                    ]
                    input[1] = [ [:], [] ]
                    input[2] = [ [:], [] ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true) ])
                input[4] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.filtered.gtf', checkIfExists: true) ])
                input[5] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[6] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.gtf', checkIfExists: true) ])
                input[7] = channel.of(
                    [ [ id:'fust1_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.meta.bed', checkIfExists: true) ]
                )
                input[8] = 2
                input[9] = channel.value([ [ id:'phenotype' ], file(params.pipelines_testdata_base_path + 'mini/phenotype.csv', checkIfExists: true) ])
                input[10] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/chrI_mini.fa.fai', checkIfExists: true) ])
                input[11] = BWA_INDEX.out.index.collect()
                input[12] = HISAT2_BUILD.out.index.collect()
                input[13] = ['psirc', 'ciriquant', 'max']
                input[14] = 5
                input[15] = false
                input[16] = channel.empty()
                """
            }
        }

        then {
            def circular = path(workflow.out.circ.find { it[0].quantification == 'psirc' }[1]).csv(sep: '\t')
            def gene = path(workflow.out.gene.find { it[0].quantification == 'psirc' }[1]).csv(sep: '\t')
            def ciriquantGene = path(workflow.out.gene.find { it[0].id == 'gene' }[1]).csv(sep: '\t')
            def ciriquantCirc = path(workflow.out.circ.find { it[0].id == 'circ' }[1])
            def max = path("$outputDir/5_quantification/aggregations/max.tsv").csv(sep: '\t')
            assertAll(
                { assert workflow.success },
                { assert circular.columnNames == [ 'tx', 'gene_id', 'cel_N2_1', 'fust1_1' ] },
                { assert circular.rowCount > 0 },
                { assert gene.rowCount > 0 },
                { assert workflow.out.rds.size() == 1 },
                { assert workflow.out.gene.size() == 2 },
                { assert workflow.out.circ.size() == 2 },
                { assert ciriquantGene.columnNames == [ 'gene_id', 'gene_name', 'cel_N2_1', 'fust1_1' ] },
                { assert ciriquantGene.rowCount > 0 },
                { assert ciriquantCirc.readLines().size() == 1 },
                { assert ciriquantCirc.readLines()[0].split('\t').toList() == [ 'circ_id', 'gene_id', 'cel_N2_1', 'fust1_1' ] },
                { assert workflow.out.ciriquant.size() == 2 },
                { assert workflow.out.stringtie.size() == 2 },
                { assert !new File("$outputDir/5_quantification/aggregations/sum.tsv").exists() },
                { assert max.columnNames == [ 'id', 'cel_N2_1', 'fust1_1' ] },
                { assert max.rowCount > 0 },
                { assert snapshot(
                    workflow.out.gene.collect { meta, f -> [ meta, file(f).name ] }.sort { it[0].id },
                    workflow.out.circ.collect { meta, f -> [ meta, file(f).name ] }.sort { it[0].id },
                    workflow.out.rds.collect { meta, f -> [ meta, file(f).name ] },
                    workflow.trace.tasks().collect { it.name.replaceAll(/ \(.*\)/, '') }.unique().sort().findAll { it.contains('AGGREGATE') },
                    circular.columns['tx'],
                    gene.rowCount,
                    ciriquantGene.columnNames,
                    ciriquantGene.rowCount,
                    workflow.out.ciriquant.collect { meta, f -> [ meta.id, file(f).name ] }.sort(),
                    workflow.out.stringtie.collect { meta, f -> [ meta.id, file(f).name ] }.sort(),
                    max.rowCount,
                    max.rows.collect { row -> "${row.cel_N2_1}\t${row.fust1_1}".toString() }.sort()
                ).match() }
            )
        }
    }

    test("sum and max aggregations only") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true) ])
                input[4] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.filtered.gtf', checkIfExists: true) ])
                input[5] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[6] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.gtf', checkIfExists: true) ])
                input[7] = channel.of(
                    [ [ id:'fust1_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.meta.bed', checkIfExists: true) ]
                )
                input[8] = 2
                input[9] = channel.value([ [ id:'phenotype' ], file(params.pipelines_testdata_base_path + 'mini/phenotype.csv', checkIfExists: true) ])
                input[10] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/chrI_mini.fa.fai', checkIfExists: true) ])
                input[11] = channel.value([ [:], [] ])
                input[12] = channel.value([ [:], [] ])
                input[13] = ['sum', 'max']
                input[14] = 0
                input[15] = false
                input[16] = channel.empty()
                """
            }
        }

        then {
            def sum = path("$outputDir/5_quantification/aggregations/sum.tsv").csv(sep: '\t')
            def max = path("$outputDir/5_quantification/aggregations/max.tsv").csv(sep: '\t')
            assertAll(
                { assert workflow.success },
                { assert workflow.out.gene.isEmpty() },
                { assert workflow.out.circ.isEmpty() },
                { assert workflow.out.rds.isEmpty() },
                { assert workflow.trace.tasks().every { it.name.startsWith('QUANTIFICATION:AGGREGATE') } },
                { assert sum.columnNames == [ 'id', 'cel_N2_1', 'fust1_1' ] },
                { assert sum.rowCount > 0 },
                { assert max.columnNames == [ 'id', 'cel_N2_1', 'fust1_1' ] },
                { assert max.rowCount > 0 },
                { assert snapshot(workflow.trace.tasks().collect { it.name.replaceAll(/ \(.*\)/, '') }.unique().sort(),
                    sum.rowCount,
                    sum.rows.collect { row -> "${row.id}\t${row.cel_N2_1}\t${row.fust1_1}".toString() },
                    max.rowCount,
                    max.rows.collect { row -> "${row.id}\t${row.cel_N2_1}\t${row.fust1_1}".toString() }
                ).match() }
            )
        }
    }

    test("no quantification tools") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true) ])
                input[4] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.filtered.gtf', checkIfExists: true) ])
                input[5] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[6] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.gtf', checkIfExists: true) ])
                input[7] = channel.of(
                    [ [ id:'cel_N2_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.meta.bed', checkIfExists: true) ]
                )
                input[8] = 2
                input[9] = channel.value([ [ id:'phenotype' ], file(params.pipelines_testdata_base_path + 'mini/phenotype.csv', checkIfExists: true) ])
                input[10] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/chrI_mini.fa.fai', checkIfExists: true) ])
                input[11] = channel.value([ [:], [] ])
                input[12] = channel.value([ [:], [] ])
                input[13] = []
                input[14] = 0
                input[15] = true
                input[16] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.gene.isEmpty() },
                { assert workflow.out.circ.isEmpty() },
                { assert workflow.out.ciriquant.isEmpty() },
                { assert workflow.out.stringtie.isEmpty() },
                { assert workflow.out.rds.isEmpty() },
                { assert workflow.trace.tasks().isEmpty() },
                { assert !new File("$outputDir/5_quantification/aggregations").exists() }
            )
        }
    }

    test("all tools - stub") {

        options '-stub'

        setup {
            run("BWA_INDEX") {
                script "modules/nf-core/bwa/index/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                    ]
                    """
                }
            }
            run("HISAT2_BUILD") {
                script "modules/nf-core/hisat2/build/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'genome' ],
                        file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                    ]
                    input[1] = [ [:], [] ]
                    input[2] = [ [:], [] ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [ id:'fust1_1', single_end:false, strandedness:'auto' ],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true) ])
                input[4] = channel.value([ [ id:'transcriptome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.filtered.gtf', checkIfExists: true) ])
                input[5] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[6] = channel.value([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.gtf', checkIfExists: true) ])
                input[7] = channel.of(
                    [ [ id:'cel_N2_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'cel_N2_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'circexplorer2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circexplorer2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'ciri2' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.meta.bed', checkIfExists: true) ],
                    [ [ id:'fust1_1', tool:'segemehl' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.meta.bed', checkIfExists: true) ]
                )
                input[8] = 2
                input[9] = channel.value([ [ id:'phenotype' ], file(params.pipelines_testdata_base_path + 'mini/phenotype.csv', checkIfExists: true) ])
                input[10] = channel.value([ [ id:'genome' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/chrI_mini.fa.fai', checkIfExists: true) ])
                input[11] = BWA_INDEX.out.index.collect()
                input[12] = HISAT2_BUILD.out.index.collect()
                input[13] = ['psirc', 'ciriquant', 'sum', 'max']
                input[14] = 0
                input[15] = true
                input[16] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
