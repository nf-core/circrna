nextflow_workflow {

    name "Test Workflow CIRIFULL"
    script "../main.nf"
    workflow "CIRIFULL"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fli_tools_cirifull"

    setup {
        run("BWA_INDEX") {
            script "modules/nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                """
            }
        }
    }

    test("CIRI2 results of two samples") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], [ file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_2.fastq.gz', checkIfExists: true) ] ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], [ file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.fixed_length_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.fixed_length_2.fastq.gz', checkIfExists: true) ] ]
                )
                input[1] = channel.of([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[4] = BWA_INDEX.out.index.first()
                input[5] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true) ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.txt', checkIfExists: true) ]
                )
                input[6] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.sam', checkIfExists: true) ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.sam', checkIfExists: true) ]
                )
                input[7] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.fasta.size() == 2 },
                { assert workflow.out.bed12.size() == 2 },
                { assert workflow.out.fasta.collect { meta, _fasta -> meta.id }.sort() == ['cel_N2_1', 'fust1_1'] },
                { assert workflow.out.bed12.collect { meta, _bed -> meta.id }.sort() == ['cel_N2_1', 'fust1_1'] },
                { assert workflow.out.fasta.every { meta, fasta -> meta.fli_tool == 'cirifull' && path(fasta).readLines().any { it.startsWith('>') } } },
                { assert workflow.out.bed12.every { meta, bed -> meta.fli_tool == 'cirifull' && !path(bed).readLines().isEmpty() } },
                { assert snapshot(
                    workflow.out.fasta.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] }.sort { it[0].id },
                    workflow.out.bed12.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] }.sort { it[0].id },
                ).match() }
            )
        }
    }

    test("CIRI2 results of two samples - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], [ file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_2.fastq.gz', checkIfExists: true) ] ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], [ file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.fixed_length_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.fixed_length_2.fastq.gz', checkIfExists: true) ] ]
                )
                input[1] = channel.of([ [ id:'all' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true) ])
                input[2] = channel.value([ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ])
                input[3] = channel.value([ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ])
                input[4] = BWA_INDEX.out.index.first()
                input[5] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true) ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.txt', checkIfExists: true) ]
                )
                input[6] = channel.of(
                    [ [ id:'cel_N2_1', single_end:false, target_length:147 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.sam', checkIfExists: true) ],
                    [ [ id:'fust1_1', single_end:false, target_length:146 ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri2.sam', checkIfExists: true) ]
                )
                input[7] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.fasta.size() == 2 },
                { assert workflow.out.bed12.size() == 2 },
                { assert workflow.out.fasta.collect { meta, _fasta -> meta.id }.sort() == ['cel_N2_1', 'fust1_1'] },
                { assert workflow.out.bed12.collect { meta, _bed -> meta.id }.sort() == ['cel_N2_1', 'fust1_1'] },
                { assert workflow.out.fasta.every { meta, _fasta -> meta.fli_tool == 'cirifull' } },
                { assert workflow.out.bed12.every { meta, _bed -> meta.fli_tool == 'cirifull' } },
                { assert snapshot(
                    workflow.out.fasta.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] }.sort { it[0].id },
                    workflow.out.bed12.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] }.sort { it[0].id },
                ).match() }
            )
        }
    }
}
