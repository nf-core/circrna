nextflow_workflow {

    name "Test Workflow CIRI_READS"
    script "../main.nf"
    workflow "CIRI_READS"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "ciri_reads"

    test("mini paired-end reads are trimmed to the fifth-percentile length") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.reads.size() == 1 },
                { assert workflow.out.reads[0][0].target_length == 148 },
                { assert workflow.out.reads[0][1].size() == 2 },
                { assert workflow.out.reads[0][1].every { file(it).exists() } },
                { assert snapshot(workflow.out.reads).match() },
            )
        }
    }

    test("mini paired-end reads - stub") {
        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.reads.size() == 1 },
                { assert workflow.out.reads[0][0].target_length == 100 },
                { assert workflow.out.reads[0][1].size() == 2 },
                { assert snapshot(workflow.out.reads).match() },
            )
        }
    }
}
