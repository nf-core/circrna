                    [ [ id:'fust1_1', single_end:false ], file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.combined.bed', checkIfExists: true) ]
                )
                input[14] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.fasta.isEmpty() },
                { assert workflow.out.bed12.isEmpty() },
                { assert workflow.out.versions.isEmpty() },
                { assert workflow.trace.tasks().isEmpty() }
            )
        }
    }

