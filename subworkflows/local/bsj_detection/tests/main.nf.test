            }
        }

        then {
            def lines = { f -> path(f).readLines() }
            def key = { f, cols -> lines(f).collect { l -> l.tokenize('\t')[cols].join(':') }.sort() }
            def summarize = { out, cols -> out.collect { meta, f -> [meta, file(f).name, lines(f).size(), key(f, cols).hashCode()] }.sort { it[1] } }
            def summarizeLines = { out -> out.collect { meta, f -> [meta, file(f).name, lines(f).size(), lines(f).sort().hashCode()] }.sort { it[1] } }
