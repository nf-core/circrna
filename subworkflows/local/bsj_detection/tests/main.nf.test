    test("mini - min_tools above the number of selected tools fails") {

        when {
            params {
                outdir = "$outputDir"
                bsj_reads = 1
                exons_only = true
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [id: 'cel_N2_1', single_end: false],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [id: 'fust1_1', single_end: false],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                input[3] = null
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = BOWTIE2_BUILD.out.index.first()
                input[7] = BWA_INDEX.out.index.first()
                input[8] = channel.empty()
                input[9] = STAR_GENOMEGENERATE.out.index.first()
                input[10] = CIRCEXPLORER2_REFERENCE.out.output.map { _meta, ref -> ref }.collect()
                input[11] = channel.empty()
                input[12] = 1
                input[13] = ['find_circ']
                input[14] = []
                input[15] = channel.empty()
                input[16] = 0
                input[17] = true
                input[18] = 2
                input[19] = 1
                input[20] = true
                """
            }
        }

        then {
            def tasks = workflow.trace.tasks().collect { it.name.tokenize(" ")[0] }
            assertAll(
                { assert workflow.failed },
                { assert tasks.contains("BSJ_DETECTION:COMBINE_SAMPLES") },
                { assert !tasks.any { it.startsWith("BSJ_DETECTION:ANNOTATE_COMBINED") } },
                { assert (workflow.stdout + workflow.stderr).join('\n').contains('No circular RNAs were found by at least 2 tools and in at least 1 samples.') }
            )
        }
    }

    test("mini - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                bsj_reads = 1
                exons_only = true
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        [id: 'cel_N2_1', single_end: false],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ],
                    [
                        [id: 'fust1_1', single_end: false],
                        [
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_1.fastq.gz', checkIfExists: true),
                            file(params.pipelines_testdata_base_path + 'mini/fastq/fust1_rep1_2.fastq.gz', checkIfExists: true)
                        ]
                    ]
                )
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                input[3] = null
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = BOWTIE2_BUILD.out.index.first()
                input[7] = BWA_INDEX.out.index.first()
                input[8] = channel.empty()
                input[9] = STAR_GENOMEGENERATE.out.index.first()
                input[10] = CIRCEXPLORER2_REFERENCE.out.output.map { _meta, ref -> ref }.collect()
                input[11] = channel.empty()
                input[12] = 1
                input[13] = ['circexplorer2', 'find_circ', 'ciri']
                input[14] = []
                input[15] = channel.empty()
                input[16] = 0
                input[17] = true
                input[18] = 1
                input[19] = 1
                input[20] = true
                """
            }
        }

        then {
            def tasks = workflow.trace.tasks().collect { it.name.tokenize(" ")[0] }
            assertAll(
                { assert workflow.success },
                { assert tasks.contains("BSJ_DETECTION:STAR2PASS:PASS_2") },
                { assert tasks.contains("BSJ_DETECTION:CIRCEXPLORER2:UNIFY") },
                { assert tasks.contains("BSJ_DETECTION:FIND_CIRC:UNIFY") },
                { assert tasks.contains("BSJ_DETECTION:CIRI:UNIFY") },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
