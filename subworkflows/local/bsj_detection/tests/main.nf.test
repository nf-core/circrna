                { assert workflow.out.bed12.every { meta, f -> lines(f).size() > 0 } },
                { assert snapshot(
                    summarize(workflow.out.bed_per_sample_tool, [0, 1, 2, 4, 5]),
                    summarize(workflow.out.bed_per_sample, [0, 1, 2, 5]),
