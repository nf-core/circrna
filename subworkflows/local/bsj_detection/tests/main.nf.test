                input[3] = null
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = BOWTIE2_BUILD.out.index.first()
                input[7] = BWA_INDEX.out.index.first()
                input[8] = channel.empty()
                input[9] = STAR_GENOMEGENERATE.out.index.first()
                input[10] = CIRCEXPLORER2_REFERENCE.out.output.map { _meta, ref -> ref }.collect()
                input[11] = channel.empty()
                input[12] = 1
