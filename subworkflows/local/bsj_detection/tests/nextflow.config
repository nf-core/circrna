// Explicitly compose test-only tool options for the subworkflows exercised here.
includeConfig '../../annotation/tests/nextflow.config'
includeConfig '../../detection_tools/circexplorer2/tests/nextflow.config'
includeConfig '../../detection_tools/circminer/tests/nextflow.config'
includeConfig '../../detection_tools/circrna_finder/tests/nextflow.config'
includeConfig '../../detection_tools/circtools/tests/nextflow.config'
includeConfig '../../detection_tools/ciri2/tests/nextflow.config'
includeConfig '../../detection_tools/ciri3/tests/nextflow.config'
includeConfig '../../detection_tools/find_circ/tests/nextflow.config'
includeConfig '../../detection_tools/mapsplice/tests/nextflow.config'
includeConfig '../../detection_tools/psirc/tests/nextflow.config'
includeConfig '../../detection_tools/segemehl/tests/nextflow.config'

process {
    withName: BLACKLIST {
        ext.args   = '-v'
        ext.prefix = { "${meta.id}_${meta.tool}.blacklist" }
    }
    withName: FILTER_BSJS {
        ext.args = { "-v FS='\\t' -v OFS='\\t' '{ if (\$5 >= ${params.bsj_reads}) { print } }'" }
    }
    withName: EXTRACT_COUNTS {
        ext.args = { "-v FS='\\t' -v OFS='\\t' 'BEGIN { print \"id\", \"${meta.id}\" } { print \$4, \$5 }'" }
    }
    withName: BED_ADD_SAMPLE_TOOL {
        ext.args   = { "-v FS='\\t' -v OFS='\\t' '{ print \$1, \$2, \$3, \$4, \$5, \$6, \"${meta.id}\", \"${meta.tool}\" }'" }
        ext.prefix = { "${meta.id}_${meta.tool}" }
    }
    withName: COMBINEBEDS_READS {
        ext.prefix = { "${meta.id}_reads" }
    }
    withName: BWA_MEM {
        ext.args  = '-T 19'
        ext.args2 = '--output-fmt sam'
    }

    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 8 --sjdbOverhang 100'
    }

    withName: '.*:PASS_[12]' {
        cpus = 1
    }
}
