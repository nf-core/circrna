.DS_Store
multiqc/multiqc_data/fastqc_top_overrepresented_sequences_table.txt
multiqc/multiqc_data/multiqc.parquet
multiqc/multiqc_data/multiqc.log
multiqc/multiqc_data/multiqc_data.json
multiqc/multiqc_data/multiqc_sources.txt
multiqc/multiqc_data/multiqc_software_versions.txt
multiqc/multiqc_data/llms-full.txt
multiqc/multiqc_plots/{svg,pdf,png}/*.{svg,pdf,png}
multiqc/multiqc_report.html
pipeline_info/*.{html,json,txt,yml}

# FastQC outputs (zips and HTML vary by path to nested dir; hashes drift across runners)
**/*_fastqc.{html,zip}

# STAR genome index log (non-deterministic across CPU / compiler)
**/star/Log.out

# BSJ detection: FUSIONJUNC_<n> names, row order and sample column order vary between runs
# (the combined BED is compared as parsed content in default.nf.test)
**/*.combined.bed
**/all_samples.upset.png
**/all_samples.upset_mqc.json
**/circexplorer2.csv
**/*circexplorer2*.bed

# Quantification: psirc bootstrapping + tximport/tximeta + merged tables vary between runs
# (key tables are compared as parsed content in default.nf.test)
**/abundance.h5
**/abundance.tsv
**/run_info.json
**/pseudoalignments.bam
**/pseudoalignments.bam.bai
**/tximport/*.tsv
**/tximeta/*.rds
**/experiments.merged.rds
**/max.tsv
**/sum.tsv
**/circular.tsv
**/linear.tsv
**/{gene,tx}_{counts,tpm}.csv

# Statistical tests: the CIRCTEST p-values and plots depend on the psirc counts, which vary between runs
**/circtest/*.{pdf,txt}
