// Required before evaluating the dataset paths below, including when loaded as a pipeline test config.
includeConfig 'nextflow.config'

params {
    input     = "${params.pipelines_testdata_base_path}mini/samples_mini.csv"
    fasta     = "${params.pipelines_testdata_base_path}mini/reference/chrI_mini.fa"
    gtf       = "${params.pipelines_testdata_base_path}mini/reference/chrI_mini.gtf"
    phenotype = null
}

process {
    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 8 --sjdbOverhang 100'
    }
}
