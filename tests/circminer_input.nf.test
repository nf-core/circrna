nextflow_pipeline {

    name "circMiner input validation"
    script "../main.nf"
    config "./circminer_input.config"
    tag "pipeline"
    tag "circminer"

    test("circMiner rejects single-end input - stub") {
        options '-stub'

        when {
            params {
                outdir = "$outputDir"
                tools = 'circminer'
                fli_tools = ''
                mature = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).join('\n').contains('All samples must be paired-end when circminer is selected.') }
            )
        }
    }
}
