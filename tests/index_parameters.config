includeConfig 'mini.config'

// Assert staging inside each consumer. nf-test 0.9's task objects expose names/status,
// not work directories. Each test creates only its expected source's paths.
process {
    withName: '.*:BSJ_DETECTION:MAPSPLICE:ALIGN' {
        afterScript = 'test -f *-bowtie/index.marker'
    }
    withName: '.*:BSJ_DETECTION:FIND_CIRC:ALIGN' {
        afterScript = 'test -f *-bowtie2/index.marker'
    }
    withName: CIRI_BWA_MEM {
        afterScript = 'test -f *-bwa/index.marker'
    }
    withName: '.*:BSJ_DETECTION:STAR2PASS:PASS_1' {
        afterScript = 'test -f *-star/index.marker'
    }
    withName: '.*:BSJ_DETECTION:SEGEMEHL:ALIGN' {
        afterScript = 'test -f supplied-segemehl.idx'
    }
    withName: '.*:BSJ_DETECTION:CIRCMINER:DETECT' {
        afterScript = 'test -f supplied-circminer/index.marker'
    }
}

params {
    tools                = 'mapsplice,find_circ,ciri2,circexplorer2,segemehl,circminer'
    fli_tools            = ''
    quantification_tools = 'sum'
    mature               = null
    phenotype            = null
    skip_fastqc          = true
    skip_trimming        = true
    min_trimmed_reads    = 0
    min_tools            = 1
    bsj_reads            = 1
}
