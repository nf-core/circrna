nextflow_pipeline {
    name 'Test CIRI3 detection integration'
    script '../main.nf'
    tag 'pipeline'
    tag 'ciri3'

    test('CIRI and CIRI3 share one BWA-MEM task per sample') {
        when {
            params {
                def pinnedRoot = params.pipelines_testdata_base_path
                def sampleSheetSource = file(pinnedRoot + 'mini/samples_mini.csv', checkIfExists: true).text
                def oldFastqRoot = 'https://raw.githubusercontent.com/nictru/test-datasets/circrna/mini/fastq/'
                def sampleSheet = file("$outputDir/ciri3-shared-bwa-samples.csv")
                sampleSheet.parent.mkdirs()
                sampleSheet.text = sampleSheetSource.replace(oldFastqRoot, pinnedRoot + 'mini/fastq/')
                input = sampleSheet.toString()
                outdir = "$outputDir"
                tools = 'ciri,ciri3'
                fli_tools = ''
                quantification_tools = 'sum,max'
                mature = null
                phenotype = null
                skip_fastqc = true
                skip_trimming = true
                bootstrap_samples = 2
                min_tools = 1
            }
        }
        then {
            def tasks = workflow.trace.tasks()
            def bwaTasks = tasks.findAll { it.name.contains('CIRI_BWA_MEM') }
            assertAll(
                { assert workflow.success },
                { assert bwaTasks.size() == 2 },
                { assert !tasks.any { it.name.contains('STAR_GENOMEGENERATE') } },
                { assert tasks.count { it.name.contains('CIRI3_RUN') } == 2 }
            )
        }
    }

    test('CIRI3 alone does not generate a STAR index (stub)') {
        options '-stub'
        when {
            params {
                def pinnedRoot = params.pipelines_testdata_base_path
                def sampleSheetSource = file(pinnedRoot + 'mini/samples_mini.csv', checkIfExists: true).text
                def oldFastqRoot = 'https://raw.githubusercontent.com/nictru/test-datasets/circrna/mini/fastq/'
                def sampleSheet = file("$outputDir/ciri3-only-samples.csv")
                sampleSheet.parent.mkdirs()
                sampleSheet.text = sampleSheetSource.replace(oldFastqRoot, pinnedRoot + 'mini/fastq/')
                input = sampleSheet.toString()
                outdir = "$outputDir"
                tools = 'ciri3'
                fli_tools = ''
                quantification_tools = 'sum,max'
                mature = null
                phenotype = null
                skip_fastqc = true
                skip_trimming = true
                bootstrap_samples = 2
                min_tools = 1
            }
        }
        then {
            def tasks = workflow.trace.tasks()
            assertAll(
                { assert workflow.success },
                { assert tasks.count { it.name.contains('CIRI_BWA_MEM') } == 2 },
                { assert !tasks.any { it.name.contains('STAR_GENOMEGENERATE') } },
                { assert tasks.count { it.name.contains('CIRI3_RUN') } == 2 }
            )
        }
    }
}
