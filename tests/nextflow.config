/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nictru/test-datasets/8e6517c40bcc5d9585b01c45c152e0253851ff2a/'
}

// The nf-core BWA_INDEX module requests 7 bytes of memory per byte of FASTA, which is below the
// 6 MB minimum of docker for the small test genomes
process {
    withName: 'BWA_INDEX' {
        memory = 1.GB
    }
}

// Per-process CPU and memory requests for the pipeline tests, sized for the test data
includeConfig 'test_resources.config'

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
