/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process resource requests for the pipeline test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Selectors are scoped to 'NFCORE_CIRCRNA:.*' so that module and subworkflow tests keep
    the default label-based resources.
----------------------------------------------------------------------------------------
*/

process {
    // Peak RSS below 0.1 GB, single-threaded or startup-bound
    withName: 'NFCORE_CIRCRNA:.*:(ANNOTATE|BED2GTF|BED_ADD_SAMPLE_TOOL|COMBINE_COUNTS_PER_TOOL|COMBINE_TRANSCRIPTOME_GTFS|CIRCEXPLORER2_REFERENCE|CUSTOM_TX2GENE|CUT_BED12|EXCLUDE_OVERLONG_TRANSCRIPTS|EXTRACT_COUNTS|FAIL_ON_EMPTY|FILTER_BSJS|GET_FASTA|GTFFILTER|JOIN_GENE_COUNTS|JOIN_GENE_TPM|JOIN_TX_COUNTS|JOIN_TX_TPM|MARK_CIRCULAR|PARSE|RENAME|SAMTOOLS_FAIDX|SEQKIT_SPLIT|SJDB|SPLIT_TYPES_COUNTS|SPLIT_TYPES_TPM|TRANSCRIPTOME|UCSC_GTFTOGENEPRED|UNIFY)' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    // Peak RSS below 0.3 GB, multi-threaded polars / psirc-quant index
    withName: 'NFCORE_CIRCRNA:.*:(AGGREGATE|COMBINE_SAMPLES|COMBINE_TOOLS_PER_SAMPLE|INDEX|INVESTIGATE_SHIFTS)' {
        cpus   = 2
        memory = { 1.GB * task.attempt }
    }
    // Peak RSS 0.3 GB, runs psirc-quant with task.cpus threads (390% CPU)
    withName: 'NFCORE_CIRCRNA:.*:QUANT' {
        cpus   = 4
        memory = { 1.GB * task.attempt }
    }
    // Peak RSS below 0.9 GB
    withName: 'NFCORE_CIRCRNA:.*:(MERGE_EXPERIMENTS|TXIMETA_TXIMETA|TXIMETA_TXIMPORT)' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
    }
    // Keep the process_high CPU count: TRIMGALORE derives its core count from task.cpus, which
    // is written into the *_trimming_report.txt files
    withName: 'NFCORE_CIRCRNA:.*:TRIMGALORE' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
    }
    // Peak RSS 1.1 GB, 355% CPU
    withName: 'NFCORE_CIRCRNA:.*:(PASS_1|PASS_2)' {
        cpus   = 4
        memory = { 3.GB * task.attempt }
    }
    // Peak RSS 1.5 GB, 214% CPU
    withName: 'NFCORE_CIRCRNA:.*:FASTQC' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    // Not listed on purpose: STAR_GENOMEGENERATE keeps the process_high cpus and memory, because
    // STAR writes --runThreadN and --limitGenomeGenerateRAM into the snapshotted genomeParameters.txt
}
