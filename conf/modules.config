    withName: 'NFCORE_CIRCRNA:.*:SPLIT_TYPES_(COUNTS|TPM)' {
        publishDir = [
            path: { "${params.outdir}/5_quantification/psirc/combined" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MERGE_EXPERIMENTS' {
        publishDir = [
            path: { "${params.outdir}/5_quantification/psirc/combined" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:QUANTIFICATION:AGGREGATE' {
        publishDir = [
            path: { "${params.outdir}/5_quantification/aggregations" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MIRNA_PREDICTION:DESEQ2_NORMALIZATION' {
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/mirna_expression" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MIRNA_PREDICTION:MIRNA_FILTERING' {
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/mirna_expression" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:FORMAT_TARGETSCAN' {
        ext.args   = "-c fastx '{ print \$name \"\\t\" substr(\$seq,2,7) \"\\t0000\" }'"
        ext.prefix = 'mature'
        publishDir = [
            path: { "${params.outdir}/1_references/mirna_prediction/targetscan" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
            pattern: "mature.txt",
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:TARGETSCAN' {
        ext.prefix = { "${meta.id}.targetscan" }
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/binding_sites/tools/targetscan/output" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.txt",
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MIRANDA' {
        ext.prefix = { "${meta.id}.miranda" }
        ext.args   = "-strict"
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/binding_sites/tools/miranda/output" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.txt",
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MIRNA_TARGETS' {
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/binding_sites/targets" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.txt",
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MAJORITY_VOTE' {
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/binding_sites/majority_vote" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MIRNA_PREDICTION:COMPUTE_CORRELATIONS' {
        publishDir = [
            path: { "${params.outdir}/6_mirna_prediction/correlation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:CIRCTEST_PREPARE' {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/circtest" },
            enabled: params.save_intermediates,
            saveAs: { filename -> filename != 'versions.yml' ? filename : null },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:CIRCTEST_CIRCTEST' {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/circtest" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:CIRIQUANT_PREPDE' {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/ciriquant_de/ciriquant_prep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:STRINGTIE_PREPDE' {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/ciriquant_de/stringtie_prep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:CIRIQUANT_DE' {
        publishDir = [
            path: { "${params.outdir}/7_statistical_tests/ciriquant_de" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'NFCORE_CIRCRNA:.*:MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/8_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
