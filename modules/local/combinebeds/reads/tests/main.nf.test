nextflow_process {

    name "Test Process COMBINEBEDS_READS"
    script "../main.nf"
    process "COMBINEBEDS_READS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "combinebeds_reads"

    test("cel_N2_1 - min_tools 2, consider strand") {

        when {
            params {
                outdir = "$outputDir"
                consider_strand = true
                reads_min_tools = 2
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1' ],
                    ['ciri', 'circtools', 'find_circ', 'segemehl'],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circtools.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.find_circ.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.filtered.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            def keys = path(process.out.combined[0][1]).readLines().collect { l -> def c = l.split('\t'); [c[0], c[1], c[2], c[4], c[5]].join(':') }.sort()
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.combined.collect { meta, f -> [meta, file(f).name] },
                    keys,
                    process.out.plots.collect { file(it).name }.sort(),
                    process.out.multiqc.collect { file(it).name }.sort(),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 - min_tools 2, ignore strand") {

        when {
            params {
                outdir = "$outputDir"
                consider_strand = false
                reads_min_tools = 2
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1' ],
                    ['ciri', 'circtools', 'find_circ', 'segemehl'],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circtools.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.find_circ.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.filtered.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            def keys = path(process.out.combined[0][1]).readLines().collect { l -> def c = l.split('\t'); [c[0], c[1], c[2], c[4], c[5]].join(':') }.sort()
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.combined.collect { meta, f -> [meta, file(f).name] },
                    keys,
                    process.out.plots.collect { file(it).name }.sort(),
                    process.out.multiqc.collect { file(it).name }.sort(),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("fust1_1 - min_tools 1, consider strand") {

        when {
            params {
                outdir = "$outputDir"
                consider_strand = true
                reads_min_tools = 1
            }
            process {
                """
                input[0] = [
                    [ id:'fust1_1' ],
                    ['ciri', 'circtools', 'find_circ', 'segemehl'],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.ciri.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.circtools.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.find_circ.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/fust1_1.segemehl.filtered.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            def keys = path(process.out.combined[0][1]).readLines().collect { l -> def c = l.split('\t'); [c[0], c[1], c[2], c[4], c[5]].join(':') }.sort()
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.combined.collect { meta, f -> [meta, file(f).name] },
                    keys.size(),
                    keys.join('\n').md5(),
                    process.out.plots.collect { file(it).name }.sort(),
                    process.out.multiqc.collect { file(it).name }.sort(),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
                consider_strand = true
                reads_min_tools = 2
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1' ],
                    ['ciri', 'circtools', 'find_circ', 'segemehl'],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.circtools.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.find_circ.filtered.bed', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.segemehl.filtered.bed', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
