    test("cel_N2_1 - nothing passes min_tools 8") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def tools = ['ciri2', 'circexplorer2', 'find_circ', 'circrna_finder', 'mapsplice', 'circtools', 'segemehl']
