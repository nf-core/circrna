nextflow_process {

    name "Test Process COMBINEBEDS_FILTER"
    script "../main.nf"
    process "COMBINEBEDS_FILTER"

    tag "modules"
    tag "modules_local"
    tag "combinebeds_filter"

    test("cel_N2_1 - max_shift 0, consider strand, min_tools 1 (size of frozen combined.bed)") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def tools = ['ciri2', 'circexplorer2', 'find_circ', 'circrna_finder', 'mapsplice', 'circtools', 'segemehl']
                def base = params.pipelines_testdata_base_path + 'mini/intermediates/'
                input[0] = [
                    [ id:'cel_N2_1' ],
                    ['cel_N2_1'].collectMany { s -> tools.collect { t -> file(base + s + '.' + t + '.meta.bed', checkIfExists: true) } }
                ]
                input[1] = 0
                input[2] = true
                input[3] = 1
                input[4] = 1
                input[5] = "bed"
                """
            }
        }

        then {
            def keys = path(process.out.combined[0][1]).readLines().collect { l -> def c = l.split('\t'); [c[0], c[1], c[2], c[5]].join(':') }.sort()
            assertAll(
                { assert process.success },
                { assert keys.size() == 196 },
                { assert process.out.plots.collect { file(it).name } == ['cel_N2_1_tools.upset.png'] },
                { assert process.out.multiqc.collect { file(it).name } == ['cel_N2_1_tools.upset_mqc.json'] },
                { assert path(process.out.multiqc[0]).readLines().join('\n').contains('data:image/png;base64,') },
                { assert snapshot(
                    process.out.combined.collect { meta, f -> [meta, file(f).name] },
                    keys.size(),
                    keys.join('\n').md5(),
                    process.out.plots.flatten().collect { file(it).name }.sort(),
                    process.out.multiqc.flatten().collect { file(it).name }.sort(),
                    [path(process.out.versions[0]).yaml, path(process.out.versions[0]).yaml, path(process.out.versions[0]).yaml, path(process.out.versions[0]).yaml]
                ).match() }
            )
        }
    }

