nextflow_process {

    name "Test Process MIRNA_TARGETS"
    script "../main.nf"
    process "MIRNA_TARGETS"

    tag "modules"
    tag "modules_local"
    tag "mirna_targets"
    tag "targetscan_predict"
    tag "miranda"

    setup {
        run("TARGETSCAN") {
            script "modules/local/targetscan/predict/main.nf"
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                    .splitFasta(record: [id: true, seqString: true])
                    .map { record -> "\${record.id}\\t\${record.seqString[1..7]}\\t0000\\n" }
                    .collectFile(name: 'mature.txt')
                    .map { f -> [[id: 'mature_targetscan'], f] }
                """
            }
        }
        run("MIRANDA") {
            script "modules/nf-core/miranda/main.nf"
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = file(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                """
            }
        }
    }

    test("mini circRNAs") {

        when {
            process {
                """
                input[0] = TARGETSCAN.out.txt.join(MIRANDA.out.txt)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.results.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mini circRNAs - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = TARGETSCAN.out.txt.join(MIRANDA.out.txt)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
