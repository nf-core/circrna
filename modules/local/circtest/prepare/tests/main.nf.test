nextflow_process {

    name "Test Process CIRCTEST_PREPARE"
    script "../main.nf"
    process "CIRCTEST_PREPARE"

    tag "modules"
    tag "modules_local"
    tag "circtest"
    tag "circtest_prepare"

    test("psirc counts - 6 samples") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'counts', quantification:'psirc' ],
                    file(params.pipelines_testdata_base_path + 'full/stats/psirc.gene_counts.csv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'full/stats/psirc.circular_tx_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def genes = path(process.out.counts[0][1]).readLines()
            def circs = path(process.out.counts[0][2]).readLines()
            assertAll(
                { assert process.success },
                { assert genes.size() == circs.size() },
                { assert circs.size() > 1 },
                { assert circs[0].split('\t').toList().sort() == [ 'cel_N2_1', 'cel_N2_2', 'cel_N2_3', 'fust1_1', 'fust1_2', 'fust1_3', 'gene_id' ] },
                { assert snapshot(
                    process.out.counts,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("psirc counts - mini") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'counts', quantification:'psirc' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/psirc.gene_counts.csv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/psirc.circular_tx_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def genes = path(process.out.counts[0][1]).readLines()
            def circs = path(process.out.counts[0][2]).readLines()
            assertAll(
                { assert process.success },
                { assert genes.size() == circs.size() },
                { assert circs.size() > 1 },
                { assert circs[0].split('\t').toList().sort() == [ 'cel_N2_1', 'fust1_1', 'gene_id' ] },
                { assert snapshot(
                    process.out.counts,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("psirc counts - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'counts', quantification:'psirc' ],
                    file(params.pipelines_testdata_base_path + 'full/stats/psirc.gene_counts.csv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'full/stats/psirc.circular_tx_counts.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
