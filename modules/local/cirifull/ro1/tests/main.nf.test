nextflow_process {

    name "Test Process CIRIFULL_RO1"
    script "../main.nf"
    process "CIRIFULL_RO1"

    tag "modules"
    tag "modules_local"
    tag "cirifull_ro1"

    test("cel_N2_1 fixed-length reads") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.align.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.fastq.collect { meta, f -> [meta, file(f).name, path(f).linesGzip.size(), path(f).linesGzip.toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 fixed-length reads - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
