nextflow_process {

    name "Test Process CIRIFULL_RO2"
    script "../main.nf"
    process "CIRIFULL_RO2"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "cirifull_ro2"

    setup {
        run("BWA_INDEX") {
            script "../../../../nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }
        run("CIRIFULL_RO1") {
            script "../../ro1/main.nf"
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.fixed_length_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }
        run("BWA_MEM") {
            script "../../../../nf-core/bwa/mem/main.nf"
            process {
                """
                input[0] = CIRIFULL_RO1.out.fastq
                input[1] = BWA_INDEX.out.index
                input[2] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[3] = true
                """
            }
        }
    }

    test("cel_N2_1 RO1 alignment") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = BWA_MEM.out.sam.map { meta, sam -> [ meta, sam, meta.target_length ] }
                input[1] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.list.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 RO1 alignment - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = BWA_MEM.out.sam.map { meta, sam -> [ meta, sam, meta.target_length ] }
                input[1] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
