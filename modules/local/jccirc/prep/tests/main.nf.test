nextflow_process {

    name "Test Process JCCIRC_PREP"
    script "../main.nf"
    process "JCCIRC_PREP"

    tag "modules"
    tag "modules_local"
    tag "jccirc_prep"

    test("cel_N2_1 annotation and BSJ reads") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.annotated.bed12', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.reads.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.merged.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.versions_python,
                    process.out.versions_polars
                ).match() }
            )
        }
    }

    test("cel_N2_1 annotation and BSJ reads - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.annotated.bed12', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.reads.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
