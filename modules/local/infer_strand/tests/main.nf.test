nextflow_process {

    name "Test Process INFER_STRAND"
    script "../main.nf"
    process "INFER_STRAND"

    tag "modules"
    tag "modules_local"
    tag "infer_strand"

    test("infers canonical flanks and preserves other rows") {
        when {
            process {
                """
                def fasta = file("$outputDir/reference.fa").with { file -> file.parent.mkdirs(); file.text = '>chr1\\nAGCCGTACACCT\\n'; file }
                def fai = file("$outputDir/reference.fa.fai").with { file -> file.text = 'chr1\\t12\\t6\\t12\\t13\\n'; file }
                def bed = file("$outputDir/calls.bed").with { file -> file.text = 'chr1\\t2\\t4\\tplus\\t1\\t.\\nchr1\\t8\\t10\\tminus\\t1\\t.\\nchr1\\t3\\t5\\tunknown\\t1\\t.\\nchr1\\t2\\t4\\tknown\\t1\\t-\\textra\\n'; file }
                input[0] = [[id: 'calls'], bed]
                input[1] = [[id: 'reference'], fasta, fai]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.bed[0][1]).readLines() == ['chr1\t2\t4\tplus\t1\t+', 'chr1\t8\t10\tminus\t1\t-', 'chr1\t3\t5\tunknown\t1\t.', 'chr1\t2\t4\tknown\t1\t-\textra'] }
            )
        }
    }

    test("empty bed") {
        when {
            process {
                """
                def fasta = file("$outputDir/reference.fa").with { file -> file.parent.mkdirs(); file.text = '>chr1\\nAGCCGTACACCT\\n'; file }
                def fai = file("$outputDir/reference.fa.fai").with { file -> file.text = 'chr1\\t12\\t6\\t12\\t13\\n'; file }
                def bed = file("$outputDir/calls.bed").with { file -> file.text = ''; file }
                input[0] = [[id: 'calls'], bed]
                input[1] = [[id: 'reference'], fasta, fai]
                """
            }
        }

        then {
            assertAll({ assert process.success }, { assert path(process.out.bed[0][1]).text == '' })
        }
    }

    test("stub") {
        options '-stub'

        when {
            process {
                """
                def fasta = file("$outputDir/reference.fa").with { file -> file.parent.mkdirs(); file.text = '>chr1\\nAGCCGTACACCT\\n'; file }
                def fai = file("$outputDir/reference.fa.fai").with { file -> file.text = 'chr1\\t12\\t6\\t12\\t13\\n'; file }
                def bed = file("$outputDir/calls.bed").with { file -> file.text = 'chr1\\t2\\t4\\tplus\\t1\\t.\\n'; file }
                input[0] = [[id: 'calls'], bed]
                input[1] = [[id: 'reference'], fasta, fai]
                """
            }
        }

        then {
            assertAll({ assert process.success }, { assert path(process.out.bed[0][1]).readLines() == ['chr1\t2\t4\tplus\t1\t.'] })
        }
    }
}
