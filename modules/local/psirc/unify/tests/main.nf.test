nextflow_process {

    name "Test Process PSIRC_UNIFY"
    script "../main.nf"
    process "PSIRC_UNIFY"

    tag "modules"
    tag "modules_local"
    tag "psirc_unify"

    test("isoform table") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [ id:'cel_N2_1', single_end:false ], file("$moduleTestDir/data/full_length_isoforms.tsv", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("empty isoform table") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [ id:'cel_N2_1', single_end:false ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.psirc_bsj.junction_names_output_to_raw.tsv', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("isoform table - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [ id:'cel_N2_1', single_end:false ], file("$moduleTestDir/data/full_length_isoforms.tsv", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
