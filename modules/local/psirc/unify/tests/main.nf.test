nextflow_process {

    name "Test Process PSIRC_UNIFY"
    script "../main.nf"
    process "PSIRC_UNIFY"

    tag "modules"
    tag "modules_local"
    tag "psirc_unify"

    test("isoform table") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of(
                    'output_name\\tgenomic_loci\\tback_splice_junction_read_count\\tstrand',
                    'CIRC1\\tchrI:100-500\\t5\\t+',
                    'CIRC2\\tchrI:700-900\\t.\\t-',
                    'CIRC3\\t.\\t3\\t+',
                    'CIRC4\\tchrI:1000-1300\\t2.0\\t-'
                ).collectFile(name: 'full_length_isoforms.tsv', newLine: true).map { tsv -> [ [ id:'cel_N2_1', single_end:false ], tsv ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("empty isoform table") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [ [ id:'cel_N2_1', single_end:false ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.psirc_bsj.junction_names_output_to_raw.tsv', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("isoform table - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of(
                    'output_name\\tgenomic_loci\\tback_splice_junction_read_count\\tstrand',
                    'CIRC1\\tchrI:100-500\\t5\\t+',
                    'CIRC2\\tchrI:700-900\\t.\\t-',
                    'CIRC3\\t.\\t3\\t+',
                    'CIRC4\\tchrI:1000-1300\\t2.0\\t-'
                ).collectFile(name: 'full_length_isoforms.tsv', newLine: true).map { tsv -> [ [ id:'cel_N2_1', single_end:false ], tsv ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
