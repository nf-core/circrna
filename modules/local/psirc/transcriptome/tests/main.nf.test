nextflow_process {

    name "Test Process PSIRC_TRANSCRIPTOME"
    script "../main.nf"
    process "PSIRC_TRANSCRIPTOME"

    tag "modules"
    tag "modules_local"
    tag "psirc_transcriptome"

    test("chrI_mini gtf + fasta") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'transcriptome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'fasta' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.transcriptome.collect { meta, fasta -> [meta, file(fasta).name] },
                    path(process.out.versions[0]).yaml
                ).match() },
                { assert path(process.out.transcriptome[0][1]).readLines().size() > 0 }
            )
        }
    }

    test("chrI_mini gtf + fasta - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'transcriptome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'fasta' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
