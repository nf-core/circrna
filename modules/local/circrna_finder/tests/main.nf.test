nextflow_process {

    name "Test Process CIRCRNA_FINDER"
    script "../main.nf"
    process "CIRCRNA_FINDER"

    tag "modules"
    tag "modules_local"
    tag "circrna_finder"

    test("mini - STAR 2-pass output") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def dir = file("$outputDir/input")
                dir.mkdirs()
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.sam', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.Chimeric.out.sam')),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.Chimeric.out.junction')),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.SJ.out.tab', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.SJ.out.tab'))
                    ]
                ])
                """
            }
        }

        then {
            def rows = path(process.out.results[0][1]).readLines()
            assert process.success
            assert snapshot(
                process.out.versions_awk,
                process.out.versions_cat,
                process.out.versions_circrna_finder,
                process.out.results.collect { file(it[1]).name },
                rows.size(),
                rows.collect { it.split('\t').size() }.unique(),
                rows.sort(false).join('\n').md5()
            ).match()
        }
    }

    test("mini - STAR 2-pass output - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def dir = file("$outputDir/input")
                dir.mkdirs()
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.sam', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.Chimeric.out.sam')),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.Chimeric.out.junction')),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.SJ.out.tab', checkIfExists: true).copyTo(dir.resolve('cel_N2_1.SJ.out.tab'))
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
