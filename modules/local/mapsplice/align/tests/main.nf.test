nextflow_process {

    name "Test Process MAPSPLICE_ALIGN"
    script "../main.nf"
    process "MAPSPLICE_ALIGN"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "mapsplice_align"

    setup {
        run("BOWTIE_BUILD") {
            script "modules/nf-core/bowtie/build/main.nf"
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                """
            }
        }
        run("SEQKIT_SPLIT") {
            script "modules/local/seqkit/split/main.nf"
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                """
            }
        }
    }

    test("cel_N2_1 paired-end") {
        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE_BUILD.out.index.map { meta, index -> index }
                input[2] = SEQKIT_SPLIT.out.split
                input[3] = file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                """
            }
        }

        then {
            def fusions = path(process.out.raw_fusions[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions_mapsplice,
                    process.out.raw_fusions.collect { file(it[1]).name },
                    fusions.size(),
                    fusions.collect { it.tokenize('\t').take(3).join('\t') }.sort()
                ).match() }
            )
        }
    }

    test("cel_N2_1 paired-end - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE_BUILD.out.index.map { meta, index -> index }
                input[2] = SEQKIT_SPLIT.out.split
                input[3] = file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
