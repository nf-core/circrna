nextflow_process {

    name "Test Process ANNOTATION_BED2GTF"
    script "../main.nf"
    process "ANNOTATION_BED2GTF"

    tag "modules"
    tag "modules_local"
    tag "annotation_bed2gtf"

    test("annotated bed12 - exons_only true") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true),
                    []
                ]
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.gtf.collect { meta, gtf -> [meta, file(gtf).name, path(gtf).readLines().sort().hashCode()] },
                    [process.out.versions_python, process.out.versions_polars]
                ).match() }
            )
        }
    }

    test("annotated bed12 - exons_only false") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true),
                    []
                ]
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.gtf.collect { meta, gtf -> [meta, file(gtf).name, path(gtf).readLines().sort().hashCode()] },
                    [process.out.versions_python, process.out.versions_polars]
                ).match() }
            )
        }
    }

    test("annotated bed12 - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true),
                    []
                ]
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
