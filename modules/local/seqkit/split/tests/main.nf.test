nextflow_process {

    name "Test Process SEQKIT_SPLIT"
    script "../main.nf"
    process "SEQKIT_SPLIT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "seqkit_split"

    test("chrI_mini fasta") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.split.collect { meta, files -> [meta, [files].flatten().collect { file(it.toString()).name }] },
                    process.out.versions_seqkit
                ).match() }
            )
        }
    }

    test("chrI_mini fasta - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
