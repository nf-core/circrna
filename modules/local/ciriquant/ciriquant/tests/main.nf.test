nextflow_process {

    name "Test Process CIRIQUANT"
    script "../main.nf"
    process "CIRIQUANT"

    tag "modules"
    tag "modules_local"
    tag "ciriquant"
    tag "ciriquant_ciriquant"

    setup {
        run("BWA_INDEX") {
            script "modules/nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                """
            }
        }
        run("HISAT2_BUILD") {
            script "modules/nf-core/hisat2/build/main.nf"
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true),
                    [],
                    []
                ]
                input[1] = '64 GB'
                """
            }
        }
    }

    test("paired-end") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                input[3] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[4] = BWA_INDEX.out.index
                input[5] = HISAT2_BUILD.out.index
                input[6] = 'auto'
                """
            }
        }

        then {
            def header = path(process.out.gtf[0][1]).readLines().findAll { it.startsWith('##') }
            assertAll(
                { assert process.success },
                { assert header.contains('##Sample: cel_N2_1') },
                { assert process.out.gene_list.size() == 1 },
                { assert process.out.gene_gtf.size() == 1 },
                { assert snapshot(
                    process.out.gtf.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.gene_list.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.gene_gtf.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.versions_bwa,
                    process.out.versions_ciriquant,
                    process.out.versions_hisat2,
                    process.out.versions_pysam,
                    process.out.versions_python,
                    process.out.versions_samtools,
                    process.out.versions_stringtie,
                    header.findAll { it.startsWith('##Sample') || it.startsWith('##Total_Reads') }
                ).match() }
            )
        }
    }

    test("paired-end - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, strandedness:'auto' ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                input[3] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[4] = BWA_INDEX.out.index
                input[5] = HISAT2_BUILD.out.index
                input[6] = 'auto'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("single-end") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1_se', single_end:true, strandedness:'auto' ],
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'all' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                input[3] = [
                    [ id:'genome' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[4] = BWA_INDEX.out.index
                input[5] = HISAT2_BUILD.out.index
                input[6] = 'auto'
                """
            }
        }

        then {
            def header = path(process.out.gtf[0][1]).readLines().findAll { it.startsWith('##') }
            assertAll(
                { assert process.success },
                { assert header.contains('##Sample: cel_N2_1_se') },
                { assert process.out.gene_list.size() == 1 },
                { assert process.out.gene_gtf.size() == 1 },
                { assert snapshot(
                    process.out.gtf.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.gene_list.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.gene_gtf.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.versions_bwa,
                    process.out.versions_ciriquant,
                    process.out.versions_hisat2,
                    process.out.versions_pysam,
                    process.out.versions_python,
                    process.out.versions_samtools,
                    process.out.versions_stringtie,
                    header.findAll { it.startsWith('##Sample') || it.startsWith('##Total_Reads') }
                ).match() }
            )
        }
    }
}
