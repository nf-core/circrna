nextflow_process {

    name "Test Process CIRIQUANT_DE"
    script "../main.nf"
    process "CIRIQUANT_DE"

    tag "modules"
    tag "modules_local"
    tag "ciriquant"
    tag "ciriquant_de"

    test("synthetic counts - differential expression") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def samples = ['control_1', 'control_2', 'control_3', 'treatment_1', 'treatment_2', 'treatment_3']
                def library = file("$outputDir/synthetic_de/library.csv").with { csv ->
                    csv.parent.mkdirs()
                    csv.text = ['Sample,Group', 'control_1,C', 'control_2,C', 'control_3,C', 'treatment_1,T', 'treatment_2,T', 'treatment_3,T'].join('\\n') + '\\n'
                    csv
                }
                def counts = { prefix ->
                    (1..24).collect { index ->
                        def baseline = 50 + index * 5
                        def treatment = index <= 12 ? baseline * 3 : baseline
                        prefix + '_' + index + ',' + [baseline, baseline + 7, baseline - 4, treatment + 2, treatment - 5, treatment + 8].join(',')
                    }
                }
                def expression = file("$outputDir/synthetic_de/circ.csv").with { csv ->
                    csv.text = (['circRNA'] + samples).join(',') + '\\n' + counts('circ').join('\\n') + '\\n'
                    csv
                }
                def gene = file("$outputDir/synthetic_de/gene.csv").with { csv ->
                    csv.text = (['gene_id'] + samples).join(',') + '\\n' + counts('gene').join('\\n') + '\\n'
                    csv
                }
                input[0] = [[ id:'synthetic_de' ], library, expression, gene]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.circ[0][1]).csv().rowCount > 0 },
                { assert path(process.out.gene[0][1]).csv().rowCount > 0 },
                { assert path(process.out.circ[0][1]).csv().columnNames.containsAll(['logFC', 'logCPM', 'LR', 'PValue', 'FDR', 'DE']) },
                { assert path(process.out.gene[0][1]).csv().columnNames.containsAll(['logFC', 'logCPM', 'LR', 'PValue', 'FDR', 'DE']) },
                { assert process.out.versions_ciriquant == [['CIRIQUANT_DE', 'ciriquant', '1.1.3']] },
                { assert process.out.versions_r_base == [['CIRIQUANT_DE', 'r-base', '4.5.3']] },
                { assert process.out.versions_edger == [['CIRIQUANT_DE', 'edger', '4.10.6']] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("six samples - edgeR failure") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def samples = ['control_1', 'control_2', 'control_3', 'treatment_1', 'treatment_2', 'treatment_3']
                def library = file("$outputDir/edgeR_failure/library.csv").with { csv ->
                    csv.parent.mkdirs()
                    csv.text = ['Sample,Group', 'control_1,C', 'control_2,C', 'control_3,C', 'treatment_1,T', 'treatment_2,T', 'treatment_3,T'].join('\\n') + '\\n'
                    csv
                }
                def expression = file("$outputDir/edgeR_failure/circ.csv").with { csv ->
                    csv.text = (['circRNA'] + samples).join(',') + '\\n' + 'circ_1,0,0,0,0,0,0\\n'
                    csv
                }
                def gene = file("$outputDir/edgeR_failure/gene.csv").with { csv ->
                    csv.text = (['gene_id'] + samples).join(',') + '\\n' + (1..24).collect { index -> 'gene_' + index + ',100,107,96,' + (index <= 12 ? '300,295,308' : '100,95,108') }.join('\\n') + '\\n'
                    csv
                }
                input[0] = [[ id:'edgeR_failure' ], library, expression, gene]
                """
            }
        }

        then {
            // A 6-sample matrix with an all-zero circRNA makes edgeR fail inside CIRI_DE_replicate (exit code 0); the module must turn this into a task failure
            assertAll(
                { assert process.failed },
                { assert (process.stdout.join("\n") + process.stderr.join("\n")).contains("CIRI_DE_replicate failed") }
            )
        }
    }

    test("six samples - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def samples = ['control_1', 'control_2', 'control_3', 'treatment_1', 'treatment_2', 'treatment_3']
                def library = file("$outputDir/stub/library.csv").with { csv ->
                    csv.parent.mkdirs()
                    csv.text = ['Sample,Group', 'control_1,C', 'control_2,C', 'control_3,C', 'treatment_1,T', 'treatment_2,T', 'treatment_3,T'].join('\\n') + '\\n'
                    csv
                }
                def expression = file("$outputDir/stub/circ.csv").with { csv ->
                    csv.text = (['circRNA'] + samples).join(',') + '\\n' + (1..5).collect { index -> 'circ_' + index + ',20,22,18,60,58,64' }.join('\\n') + '\\n'
                    csv
                }
                def gene = file("$outputDir/stub/gene.csv").with { csv ->
                    csv.text = (['gene_id'] + samples).join(',') + '\\n' + (1..24).collect { index -> 'gene_' + index + ',100,107,96,300,295,308' }.join('\\n') + '\\n'
                    csv
                }
                input[0] = [[ id:'fust1_N2' ], library, expression, gene]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
