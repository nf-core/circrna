nextflow_process {

    name "Test Process MAJORITY_VOTE"
    script "../main.nf"
    process "MAJORITY_VOTE"

    tag "modules"
    tag "modules_local"
    tag "majority_vote"
    tag "targetscan_predict"
    tag "miranda"
    tag "gawk"

    setup {
        run("TARGETSCAN") {
            script "modules/local/targetscan/predict/main.nf"
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                    .splitFasta(record: [id: true, seqString: true])
                    .map { record -> "\${record.id}\\t\${record.seqString[1..7]}\\t0000\\n" }
                    .collectFile(name: 'mature.txt')
                    .map { f -> [[id: 'mature_targetscan'], f] }
                """
            }
        }
        run("MIRANDA") {
            script "modules/nf-core/miranda/main.nf"
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = file(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                """
            }
        }
        run("GAWK", alias: "UNIFY_TARGETSCAN") {
            script "modules/nf-core/gawk/main.nf"
            process {
                """
                input[0] = TARGETSCAN.out.txt.map { meta, txt -> [meta, txt, 'targetscan.tsv'] }
                input[1] = []
                input[2] = false
                """
            }
        }
        run("GAWK", alias: "UNIFY_MIRANDA") {
            script "modules/nf-core/gawk/main.nf"
            process {
                """
                input[0] = MIRANDA.out.txt.map { meta, txt -> [meta, txt, 'miranda.tsv'] }
                input[1] = []
                input[2] = false
                """
            }
        }
    }

    test("targetscan and miranda, min_tools 1") {

        when {
            process {
                """
                input[0] = UNIFY_TARGETSCAN.out.output.mix(UNIFY_MIRANDA.out.output)
                    .map { _meta, f -> f }.collect().map { files -> [[id: 'mirna'], files] }
                input[1] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.tsv.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.targets.collect { meta, f -> [meta, file(f).name, path(f).readLines().size()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("targetscan and miranda, min_tools 1 - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = UNIFY_TARGETSCAN.out.output.mix(UNIFY_MIRANDA.out.output)
                    .map { _meta, f -> f }.collect().map { files -> [[id: 'mirna'], files] }
                input[1] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
