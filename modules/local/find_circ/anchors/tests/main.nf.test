nextflow_process {

    name "Test Process FIND_CIRC_ANCHORS"
    script "../main.nf"
    process "FIND_CIRC_ANCHORS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "find_circ_anchors"

    setup {
        run("BOWTIE2_BUILD") {
            script "modules/nf-core/bowtie2/build/main.nf"
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                """
            }
        }
        run("BOWTIE2_ALIGN") {
            script "modules/nf-core/bowtie2/align/main.nf"
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1', single_end: false],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE2_BUILD.out.index
                input[2] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                input[3] = false
                input[4] = true
                """
            }
        }
        run("SAMTOOLS_INDEX") {
            script "modules/nf-core/samtools/index/main.nf"
            process {
                """
                input[0] = BOWTIE2_ALIGN.out.bam
                """
            }
        }
        run("SAMTOOLS_VIEW") {
            script "modules/nf-core/samtools/view/main.nf"
            process {
                """
                input[0] = BOWTIE2_ALIGN.out.bam.join(SAMTOOLS_INDEX.out.index)
                input[1] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true), []]
                input[2] = [[id: 'qname'], []]
                input[3] = [[id: 'bed'], []]
                input[4] = ''
                """
            }
        }
    }

    test("cel_N2_1 unmapped reads") {
        when {
            process {
                """
                input[0] = SAMTOOLS_VIEW.out.bam
                """
            }
        }

        then {
            def anchors = path(process.out.anchors[0][1]).linesGzip
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.versions[0]).yaml,
                    file(process.out.anchors[0][1]).name,
                    anchors.size(),
                    anchors.sort().toString().md5()
                ).match() }
            )
        }
    }

    test("cel_N2_1 unmapped reads - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = SAMTOOLS_VIEW.out.bam
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
