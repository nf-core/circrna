nextflow_process {

    name "Test Process CIRI_READLENGTH"
    script "../main.nf"
    process "CIRI_READLENGTH"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ciri_readlength"

    setup {
        run("SEQKIT_FX2TAB") {
            script "modules/nf-core/seqkit/fx2tab/main.nf"
            process {
                """
                input[0] = channel.of(
                    [[id: 'cel_N2_1_r1'], file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true)],
                    [[id: 'cel_N2_1_r2'], file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)]
                )
                input[1] = 'txt'
                """
            }
        }
    }

    test("cel_N2_1 paired-end read lengths") {
        when {
            process {
                """
                input[0] = SEQKIT_FX2TAB.out.text
                    .toSortedList { a, b -> a[0].id <=> b[0].id }
                    .map { items -> [[id: 'cel_N2_1'], items.collect { it[1] }] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions_python,
                    process.out.versions_polars,
                    file(process.out.length[0][1]).name,
                    path(process.out.length[0][1]).text
                ).match() }
            )
        }
    }

    test("cel_N2_1 paired-end read lengths - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = SEQKIT_FX2TAB.out.text
                    .toSortedList { a, b -> a[0].id <=> b[0].id }
                    .map { items -> [[id: 'cel_N2_1'], items.collect { it[1] }] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
