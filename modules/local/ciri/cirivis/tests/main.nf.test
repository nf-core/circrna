nextflow_process {

    name "Test Process CIRI_CIRIVIS"
    script "../main.nf"
    process "CIRI_CIRIVIS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ciri_cirivis"

    setup {
        run("BWA_INDEX") {
            script "modules/nf-core/bwa/index/main.nf"
            process {
                """
                input[0] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                """
            }
        }
        run("CIRIFULL_RO1") {
            script "modules/local/cirifull/ro1/main.nf"
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    [
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_1.fastq.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.fixed_length_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }
        run("BWA_MEM") {
            script "modules/nf-core/bwa/mem/main.nf"
            process {
                """
                input[0] = CIRIFULL_RO1.out.fastq
                input[1] = BWA_INDEX.out.index
                input[2] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                input[3] = true
                """
            }
        }
        run("CIRIFULL_RO2") {
            script "modules/local/cirifull/ro2/main.nf"
            process {
                """
                input[0] = BWA_MEM.out.sam.map { meta, sam -> [ meta, sam, meta.target_length ] }
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                """
            }
        }
        run("CIRI_CIRIAS") {
            script "modules/local/ciri/cirias/main.nf"
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.sam', checkIfExists: true)
                ]
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                input[2] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ]
                """
            }
        }
        run("CIRIFULL_MERGE") {
            script "modules/local/cirifull/merge/main.nf"
            process {
                """
                input[0] = CIRI_CIRIAS.out.list
                    .join(CIRIFULL_RO2.out.list)
                    .map { meta, jav, ro2 -> [ meta, file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true), jav, ro2 ] }
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                input[2] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ]
                """
            }
        }
        run("BUILD_LIST") {
            script "modules/local/ciri/build_list/main.nf"
            process {
                """
                input[0] = CIRIFULL_MERGE.out.anno
                    .map { _meta, anno -> [ [ id:'cirifull' ], anno ] }
                    .groupTuple()
                    .combine(channel.of(file(params.pipelines_testdata_base_path + 'mini/intermediates/all.annotated.bed12', checkIfExists: true)))
                input[1] = 0
                """
            }
        }
    }

    test("cel_N2_1 merged annotation") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = CIRIFULL_MERGE.out.anno
                    .join(CIRI_CIRIAS.out.library_length)
                    .combine(BUILD_LIST.out.list.map { _meta, list -> list })
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.fasta.collect { meta, f -> [meta, file(f).name] },
                    process.out.list.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.pdf.flatten().collect { f -> file(f).name }.sort(),
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 merged annotation - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = CIRIFULL_MERGE.out.anno
                    .join(CIRI_CIRIAS.out.library_length)
                    .combine(BUILD_LIST.out.list.map { _meta, list -> list })
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
