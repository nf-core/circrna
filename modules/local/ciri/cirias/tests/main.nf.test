nextflow_process {

    name "Test Process CIRI_CIRIAS"
    script "../main.nf"
    process "CIRI_CIRIAS"

    tag "modules"
    tag "modules_local"
    tag "ciri_cirias"

    test("cel_N2_1 CIRI2 result") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.sam', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.list.collect { meta, f -> [meta, file(f).name, path(f).readLines().collect { it.split('\t').take(7).join('\t') }.sort().toString().md5()] },
                    process.out.library_length.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("cel_N2_1 CIRI2 result - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'cel_N2_1', single_end:false, target_length:147 ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri.sam', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'chrI_mini' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
