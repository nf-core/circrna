nextflow_process {

    name "Test Process CIRCMINER_CIRCMINER"
    script "../main.nf"
    process "CIRCMINER_CIRCMINER"

    tag "modules"
    tag "modules_local"
    tag "circminer"
    tag "circminer_circminer"

    setup {
        run("AGAT_CONVERTSPGFF2GTF") {
            script "modules/nf-core/agat/convertspgff2gtf/main.nf"
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)]
                """
            }
        }
        run("CIRCMINER_ORDERGTF") {
            script "modules/local/circminer/ordergtf/main.nf"
            process {
                """
                input[0] = AGAT_CONVERTSPGFF2GTF.out.output_gtf
                """
            }
        }
        run("CIRCMINER_INDEX") {
            script "modules/local/circminer/index/main.nf"
            process {
                """
                input[0] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                """
            }
        }
    }

    test("mini paired-end calls or writes an empty report") {
        when {
            process {
                """
                input[0] = [[id: 'cel_N2_1', single_end: false], [file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)]]
                input[1] = CIRCMINER_INDEX.out.index
                input[2] = CIRCMINER_ORDERGTF.out.gtf
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            assert path(process.out.report[0][1]).exists()
        }
    }

    test("mini paired-end - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = [[id: 'cel_N2_1', single_end: false], [file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true), file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)]]
                input[1] = CIRCMINER_INDEX.out.index
                input[2] = CIRCMINER_ORDERGTF.out.gtf
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            assert path(process.out.report[0][1]).exists()
        }
    }
}
