nextflow_process {

    name "Test Process CSVTK_SUMMARY"
    script "../main.nf"
    process "CSVTK_SUMMARY"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "csvtk_summary"

    test("ciri2 table - group by type") {
        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1'],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.versions[0]).yaml,
                    file(process.out.csv[0][1]).name,
                    path(process.out.csv[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("ciri2 table - group by strand, tsv output") {
        config "./tsv.nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1'],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.csv[0][1]).name,
                    path(process.out.csv[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("ciri2 table - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1'],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
