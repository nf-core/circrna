nextflow_process {

    name "Test Process DESEQ2_NORMALIZATION"
    script "../main.nf"
    process "DESEQ2_NORMALIZATION"

    tag "modules"
    tag "modules_local"
    tag "deseq2_normalization"

    test("mini miRNA expression") {

        when {
            process {
                """
                input[0] = [
                    [ id:'mirna' ],
                    file(params.pipelines_testdata_base_path + 'mini/mirna_expression.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.normalized.collect { meta, f -> [meta, file(f).name, path(f).csv(sep: '\t').columnNames, path(f).csv(sep: '\t').rowCount] },
                    process.out.normalized.collect { meta, f -> path(f).readLines().sort().toString().md5() },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mini miRNA expression - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'mirna' ],
                    file(params.pipelines_testdata_base_path + 'mini/mirna_expression.tsv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
