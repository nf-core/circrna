nextflow_process {

    name "Test Process TARGETSCAN_DATABASE"
    script "../main.nf"
    process "TARGETSCAN_DATABASE"

    tag "modules"
    tag "modules_local"
    tag "targetscan_database"

    test("mini mature miRNAs") {

        when {
            process {
                """
                input[0] = [
                    [ id:'mature' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.mature_txt.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("mini mature miRNAs - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'mature' ],
                    file(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
