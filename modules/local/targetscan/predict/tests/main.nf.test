nextflow_process {

    name "Test Process TARGETSCAN"
    script "../main.nf"
    process "TARGETSCAN"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "targetscan_predict"

    test("mini circRNAs") {

        when {
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                    .splitFasta(record: [id: true, seqString: true])
                    .map { record -> "\${record.id}\\t\${record.seqString[1..7]}\\t0000\\n" }
                    .collectFile(name: 'mature.txt')
                    .map { f -> [[id: 'mature_targetscan'], f] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.txt.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.versions_awk,
                    process.out.versions_targetscan
                ).match() }
            )
        }
    }

    test("mini circRNAs - stub") {

        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [ id:'batch_1' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/all.fa', checkIfExists: true)
                ]
                input[1] = channel.fromPath(params.pipelines_testdata_base_path + 'mini/reference/mature_mini.fa', checkIfExists: true)
                    .splitFasta(record: [id: true, seqString: true])
                    .map { record -> "\${record.id}\\t\${record.seqString[1..7]}\\t0000\\n" }
                    .collectFile(name: 'mature.txt')
                    .map { f -> [[id: 'mature_targetscan'], f] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
