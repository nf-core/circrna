nextflow_process {

    name "Test Process CIRI2"
    script "../main.nf"
    process "CIRI2"

    tag "modules"
    tag "modules_local"
    tag "ciri2"

    test("cel_N2_1 BWA-MEM alignment") {
        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1', single_end: false],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.sam', checkIfExists: true)
                ]
                input[1] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                input[2] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.versions[0]).yaml,
                    file(process.out.txt[0][1]).name,
                    path(process.out.txt[0][1]).readLines().collect { it.tokenize('\t').take(11).join('\t') }.sort()
                ).match() }
            )
        }
    }

    test("cel_N2_1 BWA-MEM alignment - stub") {
        options '-stub'

        when {
            process {
                """
                input[0] = [
                    [id: 'cel_N2_1', single_end: false],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.ciri2.sam', checkIfExists: true)
                ]
                input[1] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)]
                input[2] = [[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
