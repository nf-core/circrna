process {
    withName: 'STAR_GENOMEGENERATE' {
        ext.args = '--genomeSAindexNbases 8 --sjdbOverhang 100'
    }

    withName: 'STAR_ALIGN_MATE1|STAR_ALIGN_MATE2' {
        cpus = 1
        ext.args = '--chimOutType Junctions WithinBAM --outSAMunmapped Within --outFilterType BySJout --outReadsUnmapped None --readFilesCommand zcat --alignSJDBoverhangMin 10 --limitSjdbInsertNsj 1000000 --chimJunctionOverhangMin 10 --chimSegmentMin 10'
    }
}
