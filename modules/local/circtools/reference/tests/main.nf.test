nextflow_process {

    name "Test Process CIRCTOOLS_REFERENCE"
    script "../main.nf"
    process "CIRCTOOLS_REFERENCE"

    tag "modules"
    tag "modules_local"
    tag "circtools_reference"

    // TODO(longread real test): blocked by missing nanopore test data (the reference is downloaded for a UCSC genome such as hg38)
    test("hg38 - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = 'hg38'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.reference.collect { file(it).name },
                    process.out.versions_circtools
                ).match() }
            )
        }
    }
}
