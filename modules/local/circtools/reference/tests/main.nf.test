nextflow_process {

    name "Test Process CIRCTOOLS_REFERENCE"
    script "../main.nf"
    process "CIRCTOOLS_REFERENCE"

    tag "modules"
    tag "modules_local"
    tag "circtools_reference"

    // Real coverage is blocked by the download-only interface: -d -R reference/ -C hg38
    // retrieves the full configured reference, with no input for a small local fixture.
    // Keep this a staging/output-contract test rather than trigger a whole-genome download.
    test("hg38 - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = 'hg38'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.reference.collect { file(it).name },
                    process.out.versions_circtools
                ).match() }
            )
        }
    }
}
