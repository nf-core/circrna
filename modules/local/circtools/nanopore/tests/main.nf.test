nextflow_process {

    name "Test Process CIRCTOOLS_NANOPORE"
    script "../main.nf"
    process "CIRCTOOLS_NANOPORE"

    tag "modules"
    tag "modules_local"
    tag "circtools_nanopore"

    // The stub only needs a staged directory, not the pipeline's assets.
    setup {
        def reference = new File(System.getenv('NFT_WORKDIR') ?: '.nf-test', 'circtools-nanopore-reference').absoluteFile
        reference.mkdirs()
    }

    // Real coverage requires a compatible circtools reference bundle and long reads;
    // the short-read input below exercises staging only, not nanopore analysis.
    // Success/version alone cannot prove analysis: circtools does not check its internal subprocess exit codes.
    test("nanopore reads - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'nanopore_1', single_end:true ],
                    file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true)
                ]
                input[1] = file("${new File(System.getenv('NFT_WORKDIR') ?: '.nf-test', 'circtools-nanopore-reference').absolutePath}", type: 'dir', checkIfExists: true)
                input[2] = 'hg38'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
