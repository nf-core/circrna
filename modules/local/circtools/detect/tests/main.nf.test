nextflow_process {

    name "Test Process CIRCTOOLS_DETECT"
    script "../main.nf"
    process "CIRCTOOLS_DETECT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "circtools"
    tag "circtools_detect"

    setup {
        run("STAR_GENOMEGENERATE") {
            script "modules/nf-core/star/genomegenerate/main.nf"
            process {
                """
                input[0] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                """
            }
        }

        run("STAR_ALIGN", alias: "STAR_ALIGN_MATE1") {
            script "modules/nf-core/star/align/main.nf"
            process {
                """
                input[0] = channel.value([[id: 'cel_N2_1', single_end: true], file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_1.fastq.gz', checkIfExists: true)])
                input[1] = STAR_GENOMEGENERATE.out.index.collect()
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                input[3] = true
                """
            }
        }

        run("STAR_ALIGN", alias: "STAR_ALIGN_MATE2") {
            script "modules/nf-core/star/align/main.nf"
            process {
                """
                input[0] = channel.value([[id: 'cel_N2_1', single_end: true], file(params.pipelines_testdata_base_path + 'mini/fastq/N2_rep1_2.fastq.gz', checkIfExists: true)])
                input[1] = STAR_GENOMEGENERATE.out.index.collect()
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                input[3] = true
                """
            }
        }
    }

    test("mini - paired-end with mate junctions") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = STAR_ALIGN_MATE1.out.junction
                    .combine(STAR_ALIGN_MATE2.out.junction.map { _meta, junction -> junction })
                    .map { _meta, mate1, mate2 ->
                        [
                            [id: 'cel_N2_1', single_end: false, strandedness: 'auto'],
                            file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true),
                            mate1,
                            mate2
                        ]
                    }
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                """
            }
        }

        then {
            // The order of the gene names in the Gene column changes between runs, so they are sorted
            assert process.success
            assert snapshot(
                path(process.out.versions[0]).yaml,
                process.out.reads.collect { file(it[1]).name },
                process.out.coordinates.collect { file(it[1]).name },
                process.out.counts.collect { file(it[1]).name },
                path(process.out.reads[0][1]).readLines().size(),
                path(process.out.coordinates[0][1]).readLines().collect { line -> def f = line.split('\t'); f[3] = f[3].split(',').sort().join(','); f.join('\t') }.sort(false).join('\n').md5(),
                path(process.out.counts[0][1]).readLines().sort(false).join('\n').md5()
            ).match()
        }
    }

    // TODO(circtools detect fails for single-end data): real single-end test blocked by tmp_printcirclines only being written with -Pi, see tickets

    test("mini - paired-end - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                    [id: 'cel_N2_1', single_end: false, strandedness: 'auto'],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true)
                ])
                input[1] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true)])
                input[2] = channel.value([[id: 'chrI_mini'], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true)])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
