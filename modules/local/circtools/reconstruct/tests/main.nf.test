nextflow_process {

    name "Test Process CIRCTOOLS_RECONSTRUCT"
    script "../main.nf"
    process "CIRCTOOLS_RECONSTRUCT"

    tag "modules"
    tag "modules_local"
    tag "circtools_reconstruct"

    setup {
        run("SAMTOOLS_SORT") {
            script "modules/nf-core/samtools/sort/main.nf"
            process {
                """
                input[0] = [ [ id:'cel_N2_1' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Aligned.out.bam', checkIfExists: true) ]
                input[1] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.fa', checkIfExists: true), [] ]
                input[2] = ''
                """
            }
        }
        run("SAMTOOLS_INDEX") {
            script "modules/nf-core/samtools/index/main.nf"
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam
                """
            }
        }
        run("CIRCTOOLS_ANNOTATION") {
            script "modules/local/circtools/annotation/main.nf"
            process {
                """
                input[0] = [ [ id:'chrI_mini' ], file(params.pipelines_testdata_base_path + 'mini/reference/chrI_mini.gtf', checkIfExists: true) ]
                """
            }
        }
    }

    test("cel_N2_1 STAR alignment") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([ [ id:'cel_N2_1' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.combined.bed', checkIfExists: true) ])
                    .join(SAMTOOLS_SORT.out.bam)
                    .join(SAMTOOLS_INDEX.out.index)
                    .map { meta, bed, bam, bai -> [ meta, bed, bam, bai, file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true) ] }
                input[1] = CIRCTOOLS_ANNOTATION.out.bed
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.alternative_splicing.collect { meta, f -> [meta, file(f).name, path(f).readLines().collect { it.split('\t').take(2).join('\t') }.sort().toString().md5()] },
                    process.out.exon_counts_bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().collect { it.split('\t').take(4).join('\t') }.sort().toString().md5()] },
                    process.out.exon_counts_txt.collect { meta, f -> [meta, file(f).name, path(f).readLines().collect { it.split('\t').take(10).join('\t') }.sort().toString().md5()] },
                    process.out.mate_status.collect { meta, f -> [meta, file(f).name, path(f).readLines().collect { it.split('\t').take(7).join('\t') }.sort().toString().md5()] },
                    process.out.skipped_exons_bed.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.skipped_exons_txt.collect { meta, f -> [meta, file(f).name, path(f).readLines().sort().toString().md5()] },
                    process.out.versions_circtools
                ).match() }
            )
        }
    }

    test("cel_N2_1 STAR alignment - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([ [ id:'cel_N2_1' ], file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.combined.bed', checkIfExists: true) ])
                    .join(SAMTOOLS_SORT.out.bam)
                    .join(SAMTOOLS_INDEX.out.index)
                    .map { meta, bed, bam, bai -> [ meta, bed, bam, bai, file(params.pipelines_testdata_base_path + 'mini/intermediates/cel_N2_1.star.Chimeric.out.junction', checkIfExists: true) ] }
                input[1] = CIRCTOOLS_ANNOTATION.out.bed
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
