nextflow_process {

    name "Test Process PSIRCQUANT_INDEX"
    script "../main.nf"
    process "PSIRCQUANT_INDEX"

    tag "modules"
    tag "modules_local"
    tag "psircquant"
    tag "psircquant_index"

    test("transcriptome") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'transcriptome' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.index[0][1]).size() > 0 },
                { assert snapshot(
                    process.out.index.collect { meta, index -> [ meta, file(index).name ] },
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }

    test("transcriptome - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'transcriptome' ],
                    file(params.pipelines_testdata_base_path + 'mini/intermediates/transcriptome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
