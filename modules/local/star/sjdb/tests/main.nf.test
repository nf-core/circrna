nextflow_process {

    name "Test Process SJDB"
    script "../main.nf"
    process "SJDB"

    tag "modules"
    tag "modules_local"
    tag "star_sjdb"

    // The frozen mini SJ.out.tab files come from the 2nd pass, where every junction is reported as annotated,
    // so SJDB would filter them all out; the input is synthetic instead.
    test("synthetic SJ.out.tab - bsj_reads 1") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                file("$outputDir/input").mkdirs()
                def tab1 = file("$outputDir/input/sample1.SJ.out.tab")
                tab1.text = ['chrI\t100\t200\t1\t1\t0\t5\t0\t30', 'chrI\t300\t400\t2\t2\t0\t1\t0\t20', 'chrI\t500\t600\t1\t1\t1\t9\t0\t30', 'chrI\t700\t800\t0\t0\t0\t4\t2\t25'].join('\\n') + '\\n'
                def tab2 = file("$outputDir/input/sample2.SJ.out.tab")
                tab2.text = ['chrI\t100\t200\t1\t1\t0\t3\t0\t30', 'chrI\t300\t400\t2\t2\t0\t2\t1\t20', 'chrI\t900\t950\t1\t1\t0\t7\t0\t12'].join('\\n') + '\\n'
                input[0] = channel.of([[id: 'star_sjdb'], [tab1, tab2]])
                input[1] = 1
                """
            }
        }

        then {
            def rows = path(process.out.sjtab[0][1]).readLines()
            assert process.success
            assert snapshot(
                path(process.out.versions[0]).yaml,
                process.out.sjtab.collect { file(it[1]).name },
                rows.size(),
                rows.collect { it.split('\t').size() }.unique(),
                path(process.out.sjtab[0][1]).md5
            ).match()
        }
    }

    test("synthetic SJ.out.tab - bsj_reads 3") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                file("$outputDir/input").mkdirs()
                def tab1 = file("$outputDir/input/sample1.SJ.out.tab")
                tab1.text = ['chrI\t100\t200\t1\t1\t0\t5\t0\t30', 'chrI\t300\t400\t2\t2\t0\t1\t0\t20', 'chrI\t500\t600\t1\t1\t1\t9\t0\t30', 'chrI\t700\t800\t0\t0\t0\t4\t2\t25'].join('\\n') + '\\n'
                def tab2 = file("$outputDir/input/sample2.SJ.out.tab")
                tab2.text = ['chrI\t100\t200\t1\t1\t0\t3\t0\t30', 'chrI\t300\t400\t2\t2\t0\t2\t1\t20', 'chrI\t900\t950\t1\t1\t0\t7\t0\t12'].join('\\n') + '\\n'
                input[0] = channel.of([[id: 'star_sjdb'], [tab1, tab2]])
                input[1] = 3
                """
            }
        }

        then {
            def rows = path(process.out.sjtab[0][1]).readLines()
            assert process.success
            assert snapshot(
                rows.size(),
                path(process.out.sjtab[0][1]).md5
            ).match()
        }
    }

    test("synthetic SJ.out.tab - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                file("$outputDir/input").mkdirs()
                def tab1 = file("$outputDir/input/sample1.SJ.out.tab")
                tab1.text = ['chrI\t100\t200\t1\t1\t0\t5\t0\t30', 'chrI\t300\t400\t2\t2\t0\t1\t0\t20', 'chrI\t500\t600\t1\t1\t1\t9\t0\t30', 'chrI\t700\t800\t0\t0\t0\t4\t2\t25'].join('\\n') + '\\n'
                def tab2 = file("$outputDir/input/sample2.SJ.out.tab")
                tab2.text = ['chrI\t100\t200\t1\t1\t0\t3\t0\t30', 'chrI\t300\t400\t2\t2\t0\t2\t1\t20', 'chrI\t900\t950\t1\t1\t0\t7\t0\t12'].join('\\n') + '\\n'
                input[0] = channel.of([[id: 'star_sjdb'], [tab1, tab2]])
                input[1] = 1
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
