     test("saccharomyces_cerevisiae - kallisto - gtf") {
 
         setup {
             run("UNTAR") {
                 script "../../../untar/main.nf"
                 process {
                     """
                     input[0] = Channel.of([
                         [ id:'test'], // meta map
