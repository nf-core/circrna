                    process.out.transcript_gtf.collect { meta, gtf -> [meta, path(gtf).text.replaceAll(/(?m)(^# stringtie .* -p )\d+/, '$1<cpus>')] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
